#!/usr/bin/env bash
# nixarchy-pkg-keys -- the plugin's keys, as a searchable sheet.
#
# These keys only exist while the menu holds the keyboard, so they are not
# Hyprland bindings and Omarchy's Keybindings menu cannot list them. This
# prints them the way Omarchy's own Learn sheets do (`KEY -> description`)
# and shows them in the same picker. It binds nothing and changes nothing.
#
#   nixarchy-pkg-keys           show the sheet
#   nixarchy-pkg-keys --print   print it

set -euo pipefail

keys() {
  cat <<'KEYS'
-- Open ---------------------------
SUPER ALT + N              -> Open or close the nixarchy packages menu.
                              Whatever you bound it to, in fact -- this is
                              only the binding the README suggests
Click the bar icon         -> The same menu, from the queued-changes badge
-- Move ---------------------------
DOWN  /  j                 -> Next row
UP  /  k                   -> Previous row
LEFT  /  h                 -> Previous tab
RIGHT  /  l                -> Next tab
TAB  /  SHIFT + TAB        -> Cycle tabs
PAGE UP  /  PAGE DOWN      -> Ten rows at a time
-- Find ---------------------------
/                          -> Search. On Apps and Services it filters what
                              is already listed; on Selection and Options it
                              searches the whole nixpkgs index
ESCAPE                     -> Clear the search, then close the menu
-- Flakes -------------------------
RETURN                     -> On the Flakes tab with a flakeref typed, ask
                              what that flake offers. Nothing is written,
                              and nothing is built
RETURN                     -> On "declare this as an input", name it: the
                              field suggests the repository's name. RETURN
                              declares it in your system flake and locks it,
                              ESC goes back. On a declared input, remove it
ESCAPE                     -> Step back out of what you are looking at,
                              before it clears the field
-- Act ----------------------------
SPACE                      -> Turn the row under the cursor on or off
RETURN                     -> Edit an option's value, or add a search result
SHIFT + RETURN             -> Add a search result from the OTHER channel.
                              It brings its own closure -- the two channels
                              share no store paths, even at the same version.
                              Press it twice: once to see what it will do,
                              once to do it
a                          -> Apply the queued changes and rebuild. Press
                              it twice: it rebuilds the whole system, so the
                              first press only says so. Any other key, or
                              five seconds, cancels
SHIFT + A                  -> Apply in a terminal instead, also pressed
                              twice. The route for a host with no polkit
                              agent to answer pkexec, and for any apply that
                              asks something the panel cannot show
r  /  SHIFT + R            -> Rebuild the search index (about a minute)
?                          -> This sheet. j / k, PAGE UP / PAGE DOWN and
                              HOME / END scroll it; any other key closes it
-- Option form --------------------
SPACE                      -> Flip a boolean
j  /  k                    -> Choose between an enum's alternatives
RETURN                     -> Write the value. On a multi-line value it is
                              a newline, and CTRL + RETURN writes
ESCAPE                     -> Cancel
                              An untouched field writes nothing: the value
                              shown is the option's own default or example,
                              and leaving it alone keeps the default
-- While applying -----------------
j / k, PAGE UP / PAGE DOWN -> Scroll the build log. Scrolling back stops it
                              following the build; END follows again
ESCAPE                     -> Stop watching the log. The build keeps going:
                              it is elevating, downloading and switching a
                              system, and stopping half way is never what
                              reaching for ESCAPE meant
KEYS
}

if [[ ${1-} == --print || ${1-} == -p ]]; then
  keys
  exit 0
fi

# The same size rule Omarchy's own sheets use: 40% of the focused screen.
monitor_height=$(hyprctl monitors -j 2>/dev/null |
  jq -r '.[] | select(.focused == true) | .height' 2>/dev/null || true)
if [[ ! $monitor_height =~ ^[0-9]+$ ]] || ((monitor_height <= 0)); then
  monitor_height=900
fi

keys | omarchy-menu-select 'nixarchy packages keys' -- \
  --width 800 --height "$((monitor_height * 40 / 100))" >/dev/null || true
