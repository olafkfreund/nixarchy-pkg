#!/usr/bin/env bash
# nixarchy-pkg -- what the nixarchy.pkg panel needs to know, as JSON.
#
# The panel is QML inside the Omarchy shell and cannot run a package
# manager. This script is the whole of its contact with the machine: it
# reads the two selection files, searches the nixpkgs index, and calls the
# nixarchy writers that already know how to edit those files safely.
#
#   state                        the catalogue and what is selected
#   search <query> [--kind K] [--limit N]
#                                rows from the nixpkgs/options index
#   toggle app|service <id>      turn a catalogue row on or off
#   pkg add|remove <attr> [--stable|--unstable]
#                                a raw nixpkgs attribute
#   opt describe <path>          an option's type, default and example
#   opt set <path> <nix-value>   write a value for it
#   opt replace <path> <nix-value>  replace a value
#   opt remove <path>            take it out again
#   draft new <url> | draft undraft <name>
#   flake show|add|remove|update|list    inspect or edit flake inputs
#   recover [--discard]          restore or keep an interrupted write
#   pending                      what is queued but not yet applied
#   check [--dry-run]            evaluate a private copy of the queued flake
#   options refresh              read options from the host's flake
#   apply                        copy into the flake and rebuild; the output
#                                is the build log as it happens, without
#                                colour, then ONE line:
#                                {"nixarchyPkgApply":{"ok","exit","message"}}
#   reindex                      rebuild the search index
#
# Every subcommand prints ONE object and exits 0, including on failure:
# a panel with `{"ok":false,"error":...}` can say what went wrong, where a
# panel with a non-zero exit and no output can only show an empty card.
#
# Nothing here reimplements a writer. Marker placement, catalogue drift,
# unfree policy, the pkgsOther channel escape, backups and the parse check
# all live in nixarchy-app-enable, nixarchy-service-enable,
# nixarchy-pkg-add, nixarchy-opt-remove and nixarchy-apply. A second
# implementation of any of them is a second set of bugs, and the #@opt
# line format is byte-exact -- nixarchy-opt-remove walks a comment block
# keyed on those bytes and nixarchy's checks.options asserts them.
#
# JSON is built with jq and never with printf: a package description or an
# option's documentation may contain a quote, a backslash or a newline,
# and the panel parses whatever this prints.

set -euo pipefail
umask 077

readonly STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/nixarchy"
readonly LOCK="$STATE_DIR/applied/lock"   # nixarchy-apply's lock, same expression
readonly TXN="$STATE_DIR/pkg-recovery"    # one write at a time, under the lock
readonly CHILDREN="$STATE_DIR/pkg-children.lock"
# This script is not on PATH; a hint to run it must name it the way it was run.
SELF=$0; case $SELF in /*) ;; *) SELF=$PWD/$SELF ;; esac; readonly SELF
readonly SETTLE_NOTE="something this write started is still running, so nothing was undone. Your backup is kept: run $SELF recover when it has finished."
WORK=""
READDIR=""
CHECKDIR=""
OPTSDIR=""
OPTSGEN=""
APPLYDIR=""
CHILD=""
CHECKING=false
PENDING=false
OPTIONS_READING=false
GUARDED=false        # true only while pkg-recovery/open belongs to this call
ROLLBACK_NOTE=""
WRITING=false        # true from begin_write on, so on_exit can answer for it
SETTLE_FAILED=false

readonly CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nixarchy"
readonly CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/nixarchy"
readonly APPS="$CONFIG_DIR/apps.nix"
readonly SERVICES="$CONFIG_DIR/services.nix"
readonly INDEX="$CACHE_DIR/index.tsv"
readonly STAMP="$CACHE_DIR/stamp"
# One rule for dropping a tag the flag already says, used by search and state.
# shellcheck disable=SC2016  # $f is a jq parameter, not a shell expansion.
readonly UNTAG_JQ='def untag($f):
  (if ($f | index("unfree")) then gsub(" *\\[unfree\\]"; "") else . end)
  | (if ($f | index("broken")) then gsub(" *\\[broken\\]"; "") else . end)
  | gsub("^ +| +$"; "");'
# shellcheck disable=SC2016 # Nix interpolation stays literal until the user is validated.
readonly DISCOVER='c: let
  lib = c.pkgs.lib;
  user = "@USER@";
  doc = prefix: opts: map (o: {
      name = lib.removePrefix prefix o.name;
      type = o.type or ""; description = o.description or "";
      default = o.default or null; example = o.example or null;
      declarations = map toString (o.declarations or [ ]);
      readOnly = o.readOnly or false;
    }) (builtins.filter (o: (o.visible or true) == true && !(o.internal or false))
         (lib.optionAttrSetToDocList opts));
  hm = c.options.home-manager.users or null;
  perUser = hm != null && (hm.valueMeta.attrs or { }) ? ${user};
in {
  nixos = doc "" c.options;
  homeManager = hm != null;
  users = if hm == null then [ ] else builtins.attrNames c.config.home-manager.users;
  inherit perUser;
  home = if hm == null then null
    else if perUser then doc "home-manager.users.${user}." hm.valueMeta.attrs.${user}.configuration.options
    else doc "<name>." (hm.type.getSubOptions [ ]);
}'

# A write that is still open is undone first, so the one answer says what is
# true afterwards.
die() {
  local e=$1
  if $CHECKING; then
    check_error=$e
    check_answer
  fi
  if $GUARDED; then
    rollback
    [ -z "$ROLLBACK_NOTE" ] || e="$1 -- but the undo failed. $ROLLBACK_NOTE"
  fi
  PENDING=false
  OPTIONS_READING=false
  jq -nc --arg e "$e" '{ok: false, error: $e}'
  exit 0
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is not on PATH"
}

# errexit and signals bypass die. Undo an open write and still answer once,
# with exit 0 like every other answer.
on_exit() {
  local rc=$?
  trap '' TERM INT HUP
  if [ -n "$CHILD" ]; then
    kill -TERM -- "-$CHILD" 2>/dev/null || :
    wait "$CHILD" 2>/dev/null || :
    CHILD=""
  fi
  if $GUARDED && [ ! -d "$TXN/open" ]; then
    # Interrupted between the commit mv and GUARDED=false: the write is final.
    jq -nc --arg e "the write was interrupted (exit $rc) after it had finished; it was kept." \
      '{ok: false, error: $e}'
    rc=0
  elif $GUARDED; then
    rollback
    jq -nc --arg e "the write was interrupted (exit $rc). ${ROLLBACK_NOTE:-Your files were put back.}" \
      '{ok: false, error: $e}'
    rc=0
  elif $WRITING && [ "$rc" != 0 ]; then
    # Killed while waiting for the lock or opening the transaction.
    jq -nc --arg e "the write was interrupted (exit $rc) before anything was changed." \
      '{ok: false, error: $e}'
    rc=0
  elif $CHECKING; then
    jq -nc --arg e "the check was interrupted (exit $rc)" '{ok:false, error:$e}'
    rc=0
  elif $PENDING; then
    jq -nc --arg e "could not read the queue (exit $rc)" '{ok:false, error:$e}'
    rc=0
  elif $OPTIONS_READING; then
    jq -nc --arg e "options refresh was interrupted (exit $rc)" '{ok:false, error:$e}'
    rc=0
  fi
  if [ -n "$OPTSGEN" ] && [ "$(readlink "$CACHE_DIR/options" 2>/dev/null || :)" != "$OPTSGEN" ]; then
    rm -rf -- "$OPTSGEN" 2>/dev/null || :
  fi
  local d
  for d in "$WORK" "$READDIR" "$CHECKDIR" "$OPTSDIR" "$APPLYDIR"; do
    [ -n "$d" ] || continue
    [ "$d" = "$WORK" ] && $SETTLE_FAILED && continue
    chmod -R u+w "$d" 2>/dev/null || :   # nix leaves read-only dirs behind
    rm -rf "$d" 2>/dev/null || :
  done
  exit "$rc"
}
trap on_exit EXIT
trap 'exit 143' TERM INT HUP

# Every write starts here, after its argument-only checks.
# begin_write recover  -- the one caller allowed past an interrupted write.
begin_write() {
  local mode=${1-} d p
  WRITING=true
  mkdir -p "$STATE_DIR/applied" "$TXN" ||
    die "cannot create $STATE_DIR (disk full?). Nothing was changed."
  exec 9>"$LOCK" || die "cannot open $LOCK. Nothing was changed."
  flock -w 5 9 ||
    die "another write or an apply is running -- try again when it finishes. Nothing was changed."
  export NIXARCHY_LOCK_HELD=1
  exec 7>>"$CHILDREN" || die "cannot open $CHILDREN. Nothing was changed."
  # Children inherit fd 7; a write killed outright leaves them holding it.
  flock -w 1 7 ||
    die "something an interrupted write started is still running. Try again when it has finished. Nothing was changed."
  # We hold the lock: any other working dir is from a write that died.
  for d in "$STATE_DIR"/pkg-work.*; do
    [ -e "$d" ] || continue
    chmod -R u+w "$d" 2>/dev/null || :
    rm -rf "$d" 2>/dev/null || :
  done
  WORK=$(mktemp -d -p "$STATE_DIR" pkg-work.XXXXXX) ||
    die "cannot create a working directory in $STATE_DIR (disk full?). Nothing was changed."
  export TMPDIR=$WORK
  # new/: died before the live files were touched. done/: died after the
  # write was final. Neither needs anything from the user.
  rm -rf "$TXN/new" "$TXN/done" 2>/dev/null || :
  if [ -e "$TXN/open" ] && [ "$mode" != recover ]; then
    local paths=""
    for p in "$TXN/open"/*.path; do [ -e "$p" ] && paths+=$(cat "$p")$'\n'; done
    die "$(recovery_message "$paths") Nothing was changed."
  fi
}

# Prints guarded paths and returns 0 for a leftover write, 1 for none, or
# 2 when a writer holds the lock (or the lock is missing).
interrupted() {
  [ -e "$TXN/open" ] || return 1
  [ -e "$LOCK" ] || return 2
  ( exec 6<"$LOCK" || exit 2
    flock -s -n 6 || exit 2
    [ -d "$TXN/open" ] || exit 1
    cat "$TXN/open"/*.path 2>/dev/null; exit 0
  )
}

recovery_message() {
  local list=${1%$'\n'}
  list=${list//$'\n'/, }
  printf 'an earlier write was interrupted (%s). To put back what was there before, run: %s recover. If the files look right as they are, run: %s recover --discard.' \
    "$list" "$SELF" "$SELF"
}

# guard FILE...  -- every file one write may change, in one call.
guard() {
  local i=0 f
  rm -rf "$TXN/new" 2>/dev/null || :
  mkdir -p "$TXN/new" || die "cannot create $TXN (disk full?). Nothing was changed."
  for f in "$@"; do
    case $f in /*) ;; *) f=$PWD/$f ;; esac   # recover may run from elsewhere
    # [ -e ] is false for a dangling symlink, and an undo of "absent" would
    # delete the link: refuse it instead (#39 keeps symlinks).
    if [ -L "$f" ] && [ ! -e "$f" ]; then
      rm -rf "$TXN/new"
      die "$f is a symlink to something that does not exist. Nothing was changed."
    fi
    if [ -e "$f" ]; then
      cp -p "$f" "$TXN/new/$i.data" ||
        { rm -rf "$TXN/new"; die "could not back up $f (disk full?). Nothing was changed."; }
    else
      : > "$TXN/new/$i.absent" ||
        { rm -rf "$TXN/new"; die "could not record $f (disk full?). Nothing was changed."; }
    fi
    printf '%s\n' "$f" > "$TXN/new/$i.path" ||
      { rm -rf "$TXN/new"; die "could not record $f (disk full?). Nothing was changed."; }
    i=$((i + 1))
  done
  mv "$TXN/new" "$TXN/open" ||
    { rm -rf "$TXN/new"; die "could not record the backup (disk full?). Nothing was changed."; }
  GUARDED=true   # only now: a guard that failed never "restores" an untouched file
}

# Put every guarded file back. Called directly, never inside $(...), so that
# GUARDED changes in this shell.
rollback() {
  local p i f failed=()
  if ! settle; then GUARDED=false; ROLLBACK_NOTE=$SETTLE_NOTE; return 0; fi
  for p in "$TXN/open"/*.path; do
    [ -e "$p" ] || continue
    i=${p%.path}
    f=$(cat "$p") || { failed+=("$p (unreadable)"); continue; }
    if [ -e "$i.absent" ]; then
      { [ ! -e "$f" ] && [ ! -L "$f" ]; } || rm -f "$f" ||
        failed+=("$f (it did not exist before; delete it)")
    elif ! cmp -s "$i.data" "$f"; then
      # Only what changed is rewritten: a refusal before the write must not
      # truncate an intact file, or fail on one it may not write (a read-only
      # flake.lock). --preserve=mode: a writer's mv may have reset it.
      cp --preserve=mode "$i.data" "$f" ||
        failed+=("$f (its earlier contents are in $i.data)")
    fi
  done
  GUARDED=false
  if [ ${#failed[@]} -eq 0 ]; then
    ROLLBACK_NOTE=""
    rm -rf "$TXN/open" 2>/dev/null ||
      ROLLBACK_NOTE="Your files were put back, but $TXN/open could not be removed; delete it."
  else
    ROLLBACK_NOTE="Could not put back: ${failed[*]}. Then run: $SELF recover (to try again) or $SELF recover --discard (to keep things as they are)."
  fi
}

# The write is final. The mv is the commit point; it is not `mv && GUARDED=false`,
# because a failed mv in an && list is exempt from errexit and the EXIT trap
# would then undo a write already reported as done.
committed() {
  if ! settle; then
    GUARDED=false   # keep open/: neither committed nor undone
    die "something this write started is still running, so the write was neither kept nor undone. When it has finished, run $SELF recover --discard to keep the change, or $SELF recover to put back what was there before."
  fi
  mv "$TXN/open" "$TXN/done" ||
    die "could not record that the write finished (disk full?), so it was undone."
  GUARDED=false
  rm -rf "$TXN/done" 2>/dev/null || :
}

# A fresh open can take the lock only after every child has closed fd 7.
settle() {
  exec 7>&-
  if ( flock -w 5 6 ) 6>>"$CHILDREN"; then return 0; fi
  SETTLE_FAILED=true
  return 1
}

# After run_writer: keep the writer's change, or undo it, and answer.
writer_finished() {
  if [ "$WRITER_RC" = 0 ]; then
    committed
  else
    rollback
    [ -z "$ROLLBACK_NOTE" ] || WRITER_OUT="$WRITER_OUT -- but the undo failed. $ROLLBACK_NOTE"
  fi
  emit_state
}

cmd_recover() {
  local discard=false p paths=()
  case "${1-}" in
    "") ;;
    --discard) discard=true ;;
    *) die "recover takes nothing or --discard, not '$1'" ;;
  esac
  begin_write recover
  [ -d "$TXN/open" ] || { state_with true "nothing to recover"; return 0; }
  for p in "$TXN/open"/*.path; do [ -e "$p" ] && paths+=("$(cat "$p")"); done
  if $discard; then
    rm -rf "$TXN/open" || die "could not remove $TXN/open"
    state_with true "kept ${paths[*]} as they are and dropped the backup"
    return 0
  fi
  GUARDED=true
  rollback
  if [ -z "$ROLLBACK_NOTE" ]; then state_with true "put back ${paths[*]}"
  else state_with false "$ROLLBACK_NOTE"; fi
}

# The paths nixarchy-search bakes in at build time: options.json and the
# six others that key the index. Read out of the installed script rather
# than hardcoded, so they follow the system generation instead of going
# stale the first time nixpkgs moves. A missing one is not fatal -- the
# features that need it say so individually.
searched() {
  local var=$1 path
  path=$(command -v nixarchy-search 2>/dev/null) || return 0
  sed -n "s/^${var}=\\(.*\\)$/\\1/p" "$path" | head -1
}


# nixarchy's own staleness test, reproduced rather than guessed: the stamp
# holds what the index was built FROM, so an index built by an older
# nixarchy-search does not merely lag nixpkgs -- it can be missing whole
# fields. The unfree and broken flags arrived in #493, and an index from
# before it reports every package as free. The panel must be able to say
# so rather than quietly dropping the warning.
#
# The seven inputs nixarchy-search keys the index on, in its stamp_key
# order; what each looks like; and what the panel calls it.
INDEX_INPUTS=(nixpkgs walk optionsjson appindex apptable flatpakrows pkgnewrow)
INDEX_GLOBS=('*-source' '*-pkg-index.nix' '*/options.json' '*-nixarchy-app-index.tsv'
             '*-nixarchy-app-attrs.tsv' '*-nixarchy-flatpak-rows.tsv' '*-nixarchy-pkg-new-row.tsv')
INDEX_NAMES=(nixpkgs 'index builder' options 'app list' 'app list' flatpaks 'new-package row')

# index_recognised V0..V6 -- every value has its input's shape (options may be empty).
index_recognised() {
  local i=0 v
  for v in "$@"; do
    if ! { [ "$i" = 2 ] && [ -z "$v" ]; }; then
      # shellcheck disable=SC2053  # the right side is a glob on purpose
      [[ $v == ${INDEX_GLOBS[i]} ]] || return 1
    fi
    i=$((i + 1))
  done
  [ "$i" = 7 ]
}

# index_facts -- {status, builtAt, changed} as one JSON object.
# status keeps the old staleness test byte for byte, so indexStale is
# exactly `.status != "fresh"`.
index_facts() {
  local status built key i cur=() st=() names=()
  if [ ! -s "$INDEX" ]; then
    jq -nc '{status: "missing", builtAt: null, changed: null}'
    return 0
  fi
  for i in "${INDEX_INPUTS[@]}"; do cur+=("$(searched "$i")"); done
  key=$(printf '%s\n' "${cur[@]}")
  if [ "$(cat "$STAMP" 2>/dev/null)" != "$key" ]; then status=stale; else status=fresh; fi
  built=$(stat -c %Y "$INDEX" 2>/dev/null) || built=""
  if [ "$status" = stale ] && command -v nixarchy-search >/dev/null 2>&1 && [ -r "$STAMP" ]; then
    mapfile -t st <"$STAMP"
    if [ "${#st[@]}" -eq 7 ] && index_recognised "${st[@]}" && index_recognised "${cur[@]}"; then
      for i in 0 1 2 3 4 5 6; do
        [ "${st[i]}" = "${cur[i]}" ] || names+=("${INDEX_NAMES[i]}")
      done
    fi
  fi
  jq -nc --arg status "$status" --arg built "$built" \
    --args '{status: $status,
             builtAt: (if $built == "" then null else ($built | tonumber) end),
             changed: ($ARGS.positional
                       | reduce .[] as $n ([]; if any(.[]; . == $n) then . else . + [$n] end)
                       | if length == 0 then null else . end)}' \
    ${names[@]+"${names[@]}"}
}

# One selection file's marked rows, as TSV for jq to pick up.
#
# A row is a line carrying `#@ <id>`, under the most recent `── Name ──`
# header. It is on when the line's first non-space character is not a
# comment -- the same question nixarchy-service-enable asks, and a more
# honest one than grepping for `<id>.enable`, because it does not answer
# "yes" to `enable = false;`.
#
# The id is taken whole, so `#@ tailscale` and `#@ tailscale.settings` are
# two different rows and the settings row is reported separately rather
# than being mistaken for the service.
rows_tsv() {
  local file=$1 kind=$2
  [ -e "$file" ] || return 0
  # A file that exists and cannot be read is not an empty one -- the rule
  # pending_changes already follows at :1146. Both callers below discard
  # this status (process substitution swallows it), so cmd_state asks for
  # itself; this is here so the next caller does not inherit the bug (#41).
  [ -r "$file" ] || return 1
  awk -F'\t' -v kind="$kind" '
    # A section header, e.g. `  # \u2500\u2500 Network \u2500\u2500\u2500\u2500`. The rule is the
    # box-drawing character itself, so a comment that merely starts with a
    # word cannot be mistaken for one.
    /^[[:space:]]*#[[:space:]]*\xe2\x94\x80/ {
      line = $0
      gsub(/\xe2\x94\x80/, "", line)
      sub(/^[[:space:]]*#[[:space:]]*/, "", line)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
      if (line != "") category = line
      next
    }

    # A marked row.
    #
    # The marker alone is not enough to recognise one. These files explain
    # their own format in prose -- "the `#@ name` markers are how the menu
    # finds a line to uncomment" -- and that sentence is not a catalogue
    # row, though it carries the marker. What tells them apart is that a
    # row is a Nix assignment: it ends in a semicolon, and prose does not.
    /#@ [^ \t]+/ {
      if (match($0, /#@ [^ \t]+/) == 0) next
      id = substr($0, RSTART + 3, RLENGTH - 3)

      body = $0
      sub(/[[:space:]]*#@ .*$/, "", body)          # drop the marker onwards
      enabled = (body ~ /^[[:space:]]*[^#[:space:]]/) ? "true" : "false"
      sub(/^[[:space:]]*#[[:space:]]?/, "", body)  # uncomment for display
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", body)
      if (body !~ /=.*;$/) next

      note = $0
      sub(/^.*#@ [^ \t]+[[:space:]]*/, "", note)   # whatever trails the marker
      sub(/^#[[:space:]]*/, "", note)
      gsub(/\t/, " ", note)

      printf "%s\t%s\t%s\t%s\t%s\t%s\n", kind, id, category, enabled, body, note
    }
  ' "$file"
}

# The `#@pkg`, `#@opt` and `#@draft` lines, which are not catalogue rows:
# they are what the user added themselves. An option line is either a set
# value or a commented scaffold, and the panel needs to tell them apart.
extras_tsv() {
  [ -f "$APPS" ] || return 0
  awk '
    match($0, /#@pkg-other [^ \t]+/) {
      print "pkg\t" substr($0, RSTART + 12, RLENGTH - 12) "\tother"; next
    }
    match($0, /#@pkg [^ \t]+/) {
      print "pkg\t" substr($0, RSTART + 6, RLENGTH - 6) "\tdefault"; next
    }
    match($0, /#@opt .*$/) {
      path = substr($0, RSTART + 6)
      sub(/[[:space:]]+$/, "", path)
      set = ($0 ~ /^[[:space:]]*#/) ? "false" : "true"
      body = $0
      sub(/[[:space:]]*#@opt .*$/, "", body)
      sub(/^[[:space:]]*#[[:space:]]?/, "", body)
      gsub(/\t/, " ", body)
      print "opt\t" path "\t" set "\t" body; next
    }
    match($0, /#@draft [^ \t]+/) {
      print "draft\t" substr($0, RSTART + 8, RLENGTH - 8) "\t"; next
    }
  ' "$APPS"
}

# Index rows needed by state, with a kind column: app labels and selected
# default package facts. Absent or stale labels leave the id on its own.
labels_tsv() {
  [ -s "$INDEX" ] || return 0
  awk -F'\t' '
    FNR == NR { if ($1 != "") { w[$1] = 1; n++ }; next }
    $1 == "app" { print "app\t" $2 "\t" $3; next }
    n && $1 == "pkg" && ($2 in w) {
      v = ""; i = index($5, "\\nversion:  ")
      if (i) { v = substr($5, i + 12); j = index(v, "\\n"); if (j) v = substr(v, 1, j - 1) }
      print "pkg\t" $2 "\t" $3 "\t" $4 "\t" v
    }
  ' <(printf '%s\n' "${1-}") "$INDEX"
}

# The index, searched. 137k rows is too many to hand a QML list model, so
# ranking and the limit happen here and the panel receives only what it
# draws.
#
# Ranked by where the query landed, because a substring match over a
# corpus this size buries the obvious answer: searching "git" should not
# open on a package whose description merely mentions it. Exact name, then
# prefix, then anywhere in the name, then the summary.
#
# Field 4 is flags for a package (`unfree broken curated:firefox`) and the
# type for an option -- the same column meaning two things, which is why
# they are separated here rather than handed over raw.
cmd_search() {
  local query="" kind="" limit=50
  while [ $# -gt 0 ]; do
    case "$1" in
      # A flag without its value used to end the script inside `shift 2`,
      # printing nothing at all (#30).
      --kind)  [ $# -ge 2 ] || die "--kind needs a value";  kind=$2;  shift 2 ;;
      --limit) [ $# -ge 2 ] || die "--limit needs a value"; limit=$2; shift 2 ;;
      --kind=*)  kind=${1#*=};  shift ;;
      --limit=*) limit=${1#*=}; shift ;;
      # Everything after -- is the query, so one can start with a dash.
      --) shift; query=${1-}; break ;;
      -*) die "unknown flag: $1" ;;
      *) query=$1; shift ;;
    esac
  done

  query="${query#"${query%%[![:space:]]*}"}"; query="${query%"${query##*[![:space:]]}"}"
  [ -n "$query" ] || die "usage: nixarchy-pkg search [--kind pkg|opt|app] [--limit N] [--] <query>"
  case "$limit" in ''|*[!0-9]*) die "--limit takes a number, not '$limit'" ;; esac
  case "$kind" in ''|pkg|opt|app) ;; *) die "--kind takes pkg, opt or app, not '$kind'" ;; esac
  [ -s "$INDEX" ] || die "no search index yet -- run: nixarchy-pkg reindex"

  local facts stale rowsfile=""
  facts=$(index_facts)
  stale=$(jq -r '.status != "fresh"' <<<"$facts")
  options_resolve
  [ -z "$OPT_DIR" ] || [ ! -f "$OPT_DIR/rows.tsv" ] || rowsfile=$OPT_DIR/rows.tsv

  jq -n \
    --rawfile rows <(
      awk -F'\t' -v OFS='\t' -v q="$query" -v want="$kind" -v lim="$limit" -v idx="$INDEX" -v rows="$rowsfile" '
        BEGIN { n = split(tolower(q), w, " ") }
        want != "" && $1 != want { next }
        # Option rows come from the flake when its cache is usable, and only
        # the system ones for now: the panel lists user-scope options once it
        # can write them.
        FILENAME == idx && rows != "" && $1 == "opt" { next }
        FILENAME != idx && $6 != "system" { next }
        {
          name = tolower($2); sum = tolower($3); best = 9
          for (i = 1; i <= n; i++) {
            if      (name == w[i])           r = 0
            else if (index(name, w[i]) == 1) r = 1
            else if (index(name, w[i]))      r = 2
            else if (index(sum, w[i]))       r = 3
            else next
            if (r < best) best = r
          }
          # Shorter names first within a rank: "git" beats "gitAndTools.git-extras"
          print best, length($2), $1, $2, $3, $4, $5, (FILENAME == idx ? "system" : $6)
        }
      ' "$INDEX" ${rowsfile:+"$rowsfile"} | sort -t"$(printf '\t')" -k1,1n -k2,2n | head -n "$limit" | cut -f3-
    ) \
    --rawfile extras <(extras_tsv) \
    --argjson stale "$stale" \
    --argjson index "$facts" \
    --argjson options "$OPT_JSON" \
    --arg query "$query" \
    "$UNTAG_JQ"'
    def lines: split("\n") | map(select(length > 0));
    ($extras | lines | map(split("\t") | select(.[0] == "opt")
      | {key: .[1], value: {set: (.[2] == "true"),
                            line: (if .[2] == "true" then (.[1] as $k | .[3] | sub("^[[:space:]]+"; "") | ltrimstr($k + " = ") | sub(";[[:space:]]*$"; ""))
                                   else .[3] end)}}) | from_entries) as $m |
    {
      ok: true,
      indexStale: $stale,
      index: $index,
      options: $options,
      query: $query,
      rows: ($rows | lines | map(split("\t")) | map(
        (if .[0] == "opt" then []
         else ((.[3] // "") | split(" ") | map(select(length > 0))) end) as $f
        | {
        kind:    .[0],
        name:    .[1],
        # The index builder also writes " [unfree]" / " [broken]" into the
        # summary, so the card said unfree twice (#30). Dropped only when the
        # structured flag is there to say it: an index from before the flags
        # existed has nothing else to warn with.
        summary: ((.[2] // "") | untag($f)),
        # An option row carries its Nix type here; a package row carries
        # flags. Never both.
        type:    (if .[0] == "opt" then (.[3] // "") else "" end),
        flags:   $f,
        scope:   (.[5] // "system"),
        # Written into the row by the index builder with its newlines
        # escaped, because fzf re-runs a preview on every keystroke and
        # could not afford to look one up. Unescaped here; the panel draws
        # it as plain text.
        preview: ((.[4] // "") | gsub("\\\\n"; "\n"))
      } + (if .[0] == "opt" then
        {set: (if $m[.[1]] == null then null else $m[.[1]].set end),
         current: (if $m[.[1]] == null then null else $m[.[1]].line end)}
        else {} end)))
    }'
}

# Every write goes through a nixarchy writer, and the panel is told the new
# state rather than being trusted to predict it: the writers refuse things
# (an unfree package under a policy that forbids it, an id that drifted out
# of the catalogue), and a panel that assumed success would draw a lie.
#
# stderr is captured and returned, because it is where the writers explain
# a refusal. `|| rc=$?` around each call, because errexit is on and a
# refusal is an answer here, not a crash.
run_writer() {
  local out rc=0
  out=$(exec 9>&-; "$@" 2>&1) || rc=$?
  WRITER_OUT=$out
  WRITER_RC=$rc
}

# The new state, plus what the writer said about getting there.
state_with() {
  local ok=$1 message=$2
  jq -n \
    --argjson state "$(cmd_state)" \
    --argjson ok "$ok" \
    --arg message "$message" \
    '$state + {ok: ($state.ok and $ok), message: $message}'
}

# The writer's exit code decides `ok`; the object is printed exactly once.
emit_state() {
  if [ "$WRITER_RC" = 0 ]; then
    state_with true "$WRITER_OUT"
  else
    state_with false "$WRITER_OUT"
  fi
}

cmd_toggle() {
  local kind=${1-} id=${2-}
  [ -n "$kind" ] && [ -n "$id" ] || die "usage: nixarchy-pkg toggle app|service <id>"
  case "$kind" in app|service) ;; *) die "toggle takes app or service, not '$kind'" ;; esac
  # The grep below escapes only dots, so a metacharacter matches rows it was
  # never meant to -- `[a-z]*` matches 54 of them in the shipped template.
  # The outcome is right today only because the external writer refuses the
  # id, which is correctness living outside this repository. Refusing what
  # cannot be an id is this tool's own business; deciding whether one exists
  # is the writer's (#41).
  case "$id" in
    *[!a-zA-Z0-9._-]* | "" ) die "'$id' is not a valid $kind id" ;;
  esac
  begin_write

  # Asked of the file rather than remembered, so two panels open at once
  # cannot disagree about which way the toggle goes.
  local file enabled verb
  case "$kind" in
    app)     file=$APPS ;;
    service) file=$SERVICES ;;
  esac
  [ -f "$file" ] || die "no $file -- log in again to have it created"

  if grep -qE "^[[:space:]]*[^#[:space:]].*#@ ${id//./\\.}([[:space:]]|\$)" "$file"; then
    enabled=true
  elif grep -qE "#@ ${id//./\\.}([[:space:]]|\$)" "$file"; then
    enabled=false
  else
    die "no $kind '$id' in $file"
  fi

  if [ "$enabled" = true ]; then verb=disable; else verb=enable; fi
  need "nixarchy-$kind-$verb"
  if [ "$kind" = service ]; then guard "$SERVICES" "$APPS"; else guard "$APPS"; fi
  run_writer "nixarchy-$kind-$verb" "$id"
  writer_finished
}

cmd_pkg() {
  local action=${1-}; shift || true
  case "$action" in
    add)
      local channel=() attrs=()
      while [ $# -gt 0 ]; do
        case "$1" in
          --stable|--unstable) channel=("$1"); shift ;;
          -*) die "unknown flag: $1" ;;
          *) attrs+=("$1"); shift ;;
        esac
      done
      [ ${#attrs[@]} -gt 0 ] || die "usage: nixarchy-pkg pkg add <attr> [--stable|--unstable]"
      need nixarchy-pkg-add
      begin_write
      guard "$APPS"
      run_writer nixarchy-pkg-add "${channel[@]}" "${attrs[@]}"
      writer_finished
      ;;
    remove)
      [ $# -gt 0 ] || die "usage: nixarchy-pkg pkg remove <attr>"
      need nixarchy-pkg-remove
      begin_write
      guard "$APPS"
      run_writer nixarchy-pkg-remove "$@"
      writer_finished
      ;;
    *) die "pkg takes add or remove, not '${action:-nothing}'" ;;
  esac
}

cmd_draft() {
  local action=${1-}; shift || true
  case "$action" in
    new)
      [ $# -gt 0 ] || die "usage: nixarchy-pkg draft new <url>"
      need nixarchy-pkg-new
      begin_write
      guard "$APPS"
      run_writer nixarchy-pkg-new "$@"
      writer_finished
      ;;
    undraft)
      [ $# -gt 0 ] || die "usage: nixarchy-pkg draft undraft <name>"
      need nixarchy-pkg-undraft
      begin_write
      guard "$APPS"
      run_writer nixarchy-pkg-undraft "$@"
      writer_finished
      ;;
    *) die "draft takes new or undraft, not '${action:-nothing}'" ;;
  esac
}

# An option's declared type, documentation, default and example, straight
# out of options.json.
#
# `default` and `example` are rendered `{_type: literalExpression, text:
# ...}` in a modern options.json and a bare JSON value in an older one, so
# both shapes are handled. They are read structurally here and never
# re-parsed out of the index's preview text, which flattened them for
# display.
#
# `widget` is this script's answer to "what can the panel draw for this?".
# Only the exact type grammar below gets a widget; other Nix types keep
# their expression editor.
opt_meta() {
  local path=$1 scope=${2:-system} oj="" source=system has_pkgs=false result
  options_resolve
  if [ -n "$OPT_DIR" ] && [ -f "$OPT_DIR/$scope.json" ]; then
    oj=$OPT_DIR/$scope.json; source=flake
  elif [ "$scope" = system ]; then
    oj=$(searched optionsjson)
  fi
  if [ -z "$oj" ] || [ ! -f "$oj" ]; then printf 'null\n'; return 0; fi
  if [ -f "$APPS" ]; then
    result=$(NIXARCHY_APPS="$APPS" nix-instantiate --eval --readonly-mode -E \
      'builtins.hasAttr "pkgs" (builtins.functionArgs (import (builtins.toPath (builtins.getEnv "NIXARCHY_APPS"))))' 2>/dev/null 9>&- 8>&-) || result=false
    [ "$result" = true ] && has_pkgs=true
  fi
  jq --arg p "$path" --arg scope "$scope" --arg source "$source" --argjson hasPkgs "$has_pkgs" '
    def literal: if type == "object" then (.text // tostring) else tojson end;
    def alt: "\"(?:[^\"\\\\]|\\\\.)*\"|-?[0-9]+";
    def integer($x): $x | test("^(signed integer|unsigned integer, meaning >=0|positive integer, meaning >0|integer between -?[0-9]+ and -?[0-9]+ \\(both inclusive\\)|[0-9]+ bit unsigned integer; between -?[0-9]+ and -?[0-9]+ \\(both inclusive\\))$");
    def enum($x): $x | test("^one of (?:" + alt + ")(?:, (?:" + alt + "))*$");
    def scalar($x):
      if $x == "boolean" then "boolean"
      elif enum($x) then "enum"
      elif integer($x) then "integer"
      elif (["string", "path", "strings concatenated with \"\\n\"", "non-empty string", "absolute path", "string, not containing newlines or colons"] | index($x)) != null then "string"
      else "scaffold" end;
    def constraint($x):
      if $x == "non-empty string" then "nonEmpty"
      elif $x == "absolute path" then "absolute"
      elif $x == "string, not containing newlines or colons" then "noNewlineColon"
      else null end;
    def unparen: if startswith("(") and endswith(")") then .[1:-1] else . end;
    def bounds:
      gsub("[()]"; "") | gsub("^(null or |list of )+"; "") as $t
      | if $t | test("^[0-9]+ bit unsigned integer; between -?[0-9]+ and -?[0-9]+|^integer between -?[0-9]+ and -?[0-9]+") then
          [$t | capture("between (?<lo>-?[0-9]+) and (?<hi>-?[0-9]+)") | .lo, .hi]
        elif $t | startswith("positive integer") then ["1", "9223372036854775807"]
        elif $t | startswith("unsigned integer") then ["0", "9223372036854775807"]
        elif $t | startswith("signed integer") then ["-9223372036854775808", "9223372036854775807"]
        else [null, null] end;
    def comps: [scan("\"[^\"]*\"|[^.]+")];
    def unquote: if startswith("\"") then .[1:-1] else . end;
    . as $all
    | ($p | comps) as $parts
    | (if $all[$p] != null then {key:$p, names:[], count:0}
       else [$all | keys[] | . as $key | ($key | comps) as $bits
         | select(($bits | length) == ($parts | length))
         | [range(0; $bits | length) | select($bits[.] == "<name>" or $bits[.] == "*")] as $slots
         | select(all(range(0; $bits | length);
             ($bits[.] == "<name>" or $bits[.] == "*") or
             (($bits[.] | unquote) == ($parts[.] | unquote))))
         | {key:$key, names:[$slots[] | $parts[.]], count:($slots | length)}]
         | sort_by(.count, .key) | first end) as $match
    | if $match == null then null else $match.key as $key
    | $match.names as $names
    | $all[$key] as $o
    | if $o == null then null else
        ($o.type // "") as $t
        | ($t | sub("^null or "; "") | unparen) as $base
        | ($base | sub("^list of "; "") | unparen) as $itemType
        | enum($base) as $listed
        | scalar($base) as $scalar
        | scalar($itemType) as $itemWidget
        | ($t | bounds) as $b
        | {
            ok: true, path: $p, scope: $scope, source: $source, type: $t,
            template: (if $key == $p then null else $key end), names: $names,
            description: ($o.description // ""), readOnly: ($o.readOnly // false),
            declarations: ($o.declarations // []),
            default: (if $o.default == null then "" else ($o.default | literal) end),
            example: (if $o.example == null then "" else ($o.example | literal) end),
            widget: (if $t == "package" or $t == "null or package" then (if $hasPkgs then "package" else "scaffold" end)
              elif ($t | startswith("list of ")) and ($itemWidget == "string" or $itemWidget == "integer") then "list"
              else $scalar end),
            item: (if ($t | startswith("list of ")) and ($itemWidget == "string" or $itemWidget == "integer") then $itemWidget else null end),
            nullable: ($t | startswith("null or ")),
            multiline: ($base == "strings concatenated with \"\\n\""),
            constraint: (if ($t | startswith("list of ")) or $scalar == "string" then constraint($itemType) else null end),
            packageNote: (if ($t == "package" or $t == "null or package") and ($hasPkgs | not) then "apps.nix does not take pkgs, so a package is written as Nix here" else null end),
            min: $b[0], max: $b[1],
            choices: (if $listed then [ $base | ltrimstr("one of ") | scan(alt) ] else [] end),
            choicesUnavailable: (($base | startswith("one of ")) and ($listed | not)),
            sensitive: (($key | comps | last) | test("(?i)(password|passwd|secret|token|apikey|privatekey|presharedkey|psk)$")) and ($t | test("string")),
            fileOption: (($key | sub("(?<l>[^.]+)$"; "\(.l)File")) as $f
              | if $all[$f] == null then null else
                  ($f | comps) as $bits
                  | [range(0; $bits | length) | if $bits[.] == "<name>" or $bits[.] == "*" then $parts[.] else $bits[.] end] | join(".") end)
          }
      end end' "$oj" 2>/dev/null || printf 'null\n'
}

cmd_opt_describe() {
  local path="" scope=system
  while [ $# -gt 0 ]; do
    case "$1" in
      --scope) [ $# -ge 2 ] || die "--scope needs a value"; scope=$2; shift 2 ;;
      --scope=*) scope=${1#*=}; shift ;;
      *) path=$1; shift ;;
    esac
  done
  [ -n "$path" ] || die "usage: nixarchy-pkg opt describe [--scope system|user] <path>"
  case "$scope" in system|user) ;; *) die "--scope takes system or user, not '$scope'" ;; esac
  options_resolve
  if [ "$scope" = user ] && { [ -z "$OPT_DIR" ] || [ ! -f "$OPT_DIR/user.json" ]; }; then
    local why="no options were read from your flake yet"
    if [ -n "$OPT_DIR" ]; then
      why=$(jq -r --arg u "$(id -un)" 'if .homeManager != true then "this host has no Home Manager (home-manager.users) in its configuration"
        elif ((.users | index($u)) == null) then ($u + " is not in home-manager.users")
        else "no Home Manager options were read for " + $u end' "$OPT_DIR/meta.json")
    fi
    die "no Home Manager options for $(id -un) -- $why"
  fi
  local meta; meta=$(opt_meta "$path" "$scope")
  if [ "$meta" = null ]; then
    if [ "$scope" = system ] && [ -z "$(searched optionsjson)" ] && [ -z "$OPT_DIR" ]; then
      die "no options.json on this system -- it builds no manual"
    fi
    jq -n --arg p "$path" '{ok:false, error:("no such option: " + $p)}'
    return
  fi

  # What apps.nix already says about it, so the form can open on the value
  # that is there rather than on the default (#28). Found by the writers'
  # own rule -- the marker at the END of the line, compared as a string,
  # never a pattern -- and reported as the local expression, verbatim:
  # `lib.mkDefault true` is text here, not a boolean.
  local found="" cstate=absent cvalue=""
  if [ "$scope" = system ] && [ -f "$APPS" ]; then
    found=$(NIXARCHY_PKG_PATH="$path" awk '
      BEGIN { p = ENVIRON["NIXARCHY_PKG_PATH"]; m = "#@opt " p }
      length($0) >= length(m) && substr($0, length($0) - length(m) + 1) == m {
        line = $0; sub(/^[ \t]*/, "", line)
        if (line == "# " p " = ;  " m) { print "scaffold"; exit }
        pre = p " = "; post = ";  " m
        if (substr(line, 1, length(pre)) == pre &&
            substr(line, length(line) - length(post) + 1) == post) {
          print "set"
          print substr(line, length(pre) + 1, length(line) - length(pre) - length(post))
          exit
        }
        # Marked, but not in either written form: somebody edited it by
        # hand. It is set; its value is everything before the marker.
        sub(/[ \t]*#@opt .*$/, "", line)
        print "set"; print line; exit
      }' "$APPS")
  fi
  if [ -n "$found" ]; then
    cstate=${found%%$'\n'*}
    [[ $found == *$'\n'* ]] && cvalue=${found#*$'\n'}
  fi

  jq --arg cstate "$cstate" --arg cvalue "$cvalue" \
    '. + {current: (if $cstate == "set" then {state:"set", value:$cvalue}
      elif $cstate == "scaffold" then {state:"scaffold"} else {state:"absent"} end)}' <<<"$meta"
}

# nixarchy-opt-remove needs each marked value on one physical line. Preserve
# its meaning by re-emitting a string literal or comparing Nix parse trees.
readonly MARKER_REFUSAL="a value cannot contain '#@' -- that is how this tool marks the options it wrote, and a value carrying one would make the panel name a different option than the one it changes. Nothing was changed."
readonly FLAT_REFUSAL="that value changes meaning when written on one line -- a newline inside a string or after a # matters. Write it on one line, or as one string. Nothing was changed."
has_opt() {
  NIXARCHY_PKG_PATH="$2" awk 'BEGIN { m = "#@opt " ENVIRON["NIXARCHY_PKG_PATH"] }
    length($0) >= length(m) && substr($0, length($0) - length(m) + 1) == m { found = 1; exit }
    END { exit !found }' "$1"
}
flat_value() {
  # `#@` is this tool's marker and a value must not be able to forge one:
  # extras_tsv reads the FIRST marker on a line and nixarchy-opt-remove the
  # LAST, so a forged one makes the panel name one option and delete another.
  [[ $1 == *'#@'* ]] && die "$MARKER_REFUSAL"
  return 0
}

# Use the same insertion point as cmd_opt_set, with no marker in the probe.
same_tree() {
  local v file why
  local -a values=("$1" "$2")
  local i=0
  for v in "${values[@]}"; do
    file="$WORK/probe-$i.nix"
    if ! NIXARCHY_PKG_VALUE="$v" awk '
      !ins && /^}[[:space:]]*$/ {
        printf "\n  __nixarchy_probe = %s;\n", ENVIRON["NIXARCHY_PKG_VALUE"]
        ins = 1
      }
      { print }
      END { if (!ins) exit 1 }
    ' "$APPS" > "$file"; then
      die "$FLAT_REFUSAL"
    fi
    if ! nix-instantiate --parse "$file" > "$WORK/probe-$i.tree" 2> "$WORK/probe-$i.err" 9>&- 8>&-; then
      if [ "$i" -eq 0 ]; then
        why=$(awk '/^error:/ { print; exit }' "$WORK/probe-$i.err")
        die "that value was refused, so nothing was changed. ${why:-nix could not parse the result}"
      fi
      return 1
    fi
    i=$((i + 1))
  done
  cmp -s "$WORK/probe-0.tree" "$WORK/probe-1.tree"
}

# Kept in a variable: an inline =~ pattern with quotes and spaces is misparsed by bash.
readonly LITERAL_RE='^\(?"([^"\\]|\\.)*"( \+ "([^"\\]|\\.)*")*\)?$'

# Rewrite the named value to one line without changing its meaning, or die.
one_line() {
  local v=${!1} p lit out
  [[ $v == *$'\n'* ]] || return 0
  p=$(nix-instantiate --parse -E "($v)" 2>/dev/null 9>&- 8>&-) || p=""
  if [[ $p =~ $LITERAL_RE ]]; then
    lit=$(nix-instantiate --eval --strict --json --readonly-mode \
          --option pure-eval true --option restrict-eval true -E "$v" 2>/dev/null 9>&- 8>&-) ||
      die "$FLAT_REFUSAL"
    out=$(jq -r 'if type != "string" then error("not a string") else . end
      | if test("[\u0000-\u0008\u000b\u000c\u000e-\u001f]") then error("control") else . end
      | gsub("\\\\"; "\\\\") | gsub("\""; "\\\"") | gsub("\n"; "\\n")
      | gsub("\t"; "\\t") | gsub("\r"; "\\r") | gsub("\\$\\{"; "\\${")
      | "\"" + . + "\""' <<<"$lit" 2>/dev/null) || die "$FLAT_REFUSAL"
    [[ $out == *'#@'* ]] && die "$MARKER_REFUSAL"
  else
    out=${v//$'\n'/ }
    same_tree "$v" "$out" || die "$FLAT_REFUSAL"
  fi
  printf -v "$1" '%s' "$out"
}

# Compare decimal literals without Bash's signed, fixed-width arithmetic.
decimal_lt() {
  local a=$1 b=$2
  [ "$a" = -0 ] && a=0
  [ "$b" = -0 ] && b=0
  if [[ $a == -* && $b != -* ]]; then return 0; fi
  if [[ $a != -* && $b == -* ]]; then return 1; fi
  if [[ $a == -* ]]; then
    a=${a#-}; b=${b#-}
    if [ ${#a} -ne ${#b} ]; then [ ${#a} -gt ${#b} ]; return; fi
    # shellcheck disable=SC2071 # Decimal digits are compared lexically after equal-length checks.
    [[ $a > $b ]]; return
  fi
  if [ ${#a} -ne ${#b} ]; then [ ${#a} -lt ${#b} ]; return; fi
  # shellcheck disable=SC2071 # Decimal digits are compared lexically after equal-length checks.
  [[ $a < $b ]]
}

check_literal() {
  local path=$1 value=$2 meta min max integer_type item nullable v constraint decoded rule tree
  local -a fields
  meta=$(opt_meta "$path")
  [ "$meta" != null ] || return 0
  mapfile -t fields < <(jq -r '[.min // "", .max // "",
    (.type | test("^(null or )?(signed integer|unsigned integer|positive integer|integer between|[0-9]+ bit unsigned integer)")),
    .item // "", .nullable, .constraint // ""] | .[]' <<<"$meta")
  min=${fields[0]} max=${fields[1]} integer_type=${fields[2]} item=${fields[3]} nullable=${fields[4]} constraint=${fields[5]}
  [ "$value" = null ] && [ "$nullable" = true ] && return 0
  if [ -n "$constraint" ]; then
    local single='^"([^"\\]|\\.)*"$'
    local list='^\[[[:space:]]*("([^"\\]|\\.)*"[[:space:]]*)*\]$'
    local list_tree='^\[ ?(\("([^"\\]|\\.)*"\) ?)*\]$'
    if { [ "$item" = string ] && [[ $value =~ $list ]]; } ||
       { [ "$item" != string ] && [[ $value =~ $single ]]; }; then
      tree=$(nix-instantiate --parse -E "$value" 2>/dev/null 9>&- 8>&-) || return 0
      if [ "$item" = string ]; then
        [[ $tree =~ $list_tree ]] || return 0
      else
        [[ $tree =~ $single ]] || return 0
      fi
      decoded=$(nix-instantiate --eval --strict --json --readonly-mode \
        --option pure-eval true --option restrict-eval true -E "$value" 2>/dev/null 9>&- 8>&-) || return 0
      case "$constraint" in
        nonEmpty) rule="a non-empty string" ;;
        absolute) rule="an absolute path" ;;
        noNewlineColon) rule="a string without newlines or colons" ;;
      esac
      if ! jq -e --arg c "$constraint" '
        def valid: if $c == "nonEmpty" then . != ""
          elif $c == "absolute" then startswith("/")
          else (contains("\n") or contains(":")) | not end;
        if type == "array" then all(.[]; type == "string" and valid)
        else type == "string" and valid end' <<<"$decoded" >/dev/null; then
        die "$path needs $rule. Nothing was changed."
      fi
    fi
  fi
  [ "$integer_type" = true ] || [ "$item" = integer ] || return 0
  if [ "$item" = integer ]; then
    [[ $value =~ ^\[[[:space:]]*(-?[0-9]+([[:space:]]+-?[0-9]+)*[[:space:]]*)?\]$ ]] || return 0
    value=${value#\[}; value=${value%\]}
  elif [[ ! $value =~ ^-?[0-9]+$ ]]; then
    return 0
  fi
  for v in $value; do
    if [[ $v =~ ^-?0[0-9]+$ ]]; then
      die "write $path as a plain number, without leading zeros. Nothing was changed."
    fi
    [[ $v =~ ^-?(0|[1-9][0-9]*)$ ]] || continue
    if { [ -n "$min" ] && decimal_lt "$v" "$min"; } ||
       { [ -n "$max" ] && decimal_lt "$max" "$v"; }; then
      die "$path takes $min to $max; $v is outside that. Nothing was changed."
    fi
  done
}

# Write a value for an option.
#
# The line is byte-exact and that is not style: nixarchy-opt-remove walks
# the comment block above a scaffold keyed on `# <path> = ;  #@opt <path>`,
# and nixarchy's checks.options asserts both forms, seed included. A near
# miss here is a line nothing can ever remove again.
#
#   <path> = <value>;  #@opt <path>       a set value
#   # <path> = ;  #@opt <path>            a scaffold's marked line
#
# It goes into apps.nix, where nixarchy-search puts option lines and where
# nixarchy-opt-remove looks for them -- not advanced.nix, which would be a
# line no remover could find.
#
# An empty value writes NOTHING and says so. A copied-out default is a line
# that reads as a choice and is not one.
cmd_opt_set() {
  local path=${1-} value=${2-}
  [ -n "$path" ] || die "usage: nixarchy-pkg opt set <path> <nix-value>"

  valid_path "$path" || die "'$path' is not an option path"

  flat_value "$value"

  if [ -z "${value//[[:space:]]/}" ]; then
    state_with true "kept the default for $path -- nothing written"
    return 0
  fi

  begin_write
  [ -f "$APPS" ] || die "no $APPS -- log in again to have it created"
  one_line value
  check_literal "$path" "$value"
  if has_opt "$APPS" "$path"; then
    die "$path is already in $APPS -- remove it first"
  fi
  guard "$APPS"

  local tmp; tmp=$(mktemp)
  # Through the environment, not `awk -v`: -v processes escape sequences in
  # the value it is given, so a Nix string containing a backslash would
  # arrive mangled. ENVIRON does no such processing. The newlines are
  # printf's inside awk for the same reason -- a $(...) payload would have
  # its trailing newline stripped, and the line would land on the closing
  # brace.
  #
  # Inserted before the module's closing brace, which is where
  # nixarchy-search puts its own option lines.
  NIXARCHY_PKG_PATH="$path" NIXARCHY_PKG_VALUE="$value" awk '
    !ins && /^}[[:space:]]*$/ {
      printf "\n  %s = %s;  #@opt %s\n",
        ENVIRON["NIXARCHY_PKG_PATH"], ENVIRON["NIXARCHY_PKG_VALUE"],
        ENVIRON["NIXARCHY_PKG_PATH"]
      ins = 1
    }
    { print }
  ' "$APPS" > "$tmp"

  # awk only inserts before a line that is exactly `}`. A module closing
  # `}  # the end` matched nothing, the file was copied through unchanged,
  # --parse passed BECAUSE it was unchanged, and this function reported
  # `set ...` over a file it never touched. `opt replace` has always
  # re-checked; this one never did (#39).
  if ! has_opt "$tmp" "$path"; then
    die "could not find where to add $path in $APPS -- its module does not close on a line of its own. Nothing was changed."
  fi

  # Nix's own words, not a guess at them. `--parse` also resolves names, so
  # the commonest failure here is not a syntax error at all: a value that
  # says `pkgs.foo` in a file whose header is `{ ... }:` fails with
  # "undefined variable 'pkgs'", and "that would have left the file
  # unparseable" sends the reader looking for a typo that is not there.
  local why
  if ! why=$(exec 9>&-; nix-instantiate --parse "$tmp" 2>&1 >/dev/null); then
    # One awk rather than `grep … | head -1`: grep exits 1 when nothing
    # matches, and under `pipefail` that killed this function before the
    # die() below could report anything -- the fallback on the next line
    # has never once been reached. `head` closing the pipe could also take
    # grep out with SIGPIPE on a long error, failing a match that DID
    # happen. awk exits 0 either way, and a here-string leaves no pipeline
    # to have a status at all.
    why=$(awk '/^error:/ { print; exit }' <<<"$why")
    die "that value was refused, so nothing was changed. ${why:-nix could not parse the result}"
  fi

  # cp, not mv: mv is rename(2), which replaces the target inode and takes
  # the 0600 mktemp gave us -- and the invoking user as owner -- with it. A
  # root-owned /etc/nixos file edited through a writable directory would
  # come out user-owned, and a symlinked apps.nix would be replaced by a
  # real file with the dotfiles original left untouched. cp truncates in
  # place, so inode, mode, owner and the symlink all survive (#39).
  cp "$tmp" "$APPS"
  committed

  state_with true "set $path = $value"
}

# Change an option that is already set, in one command that either changes
# it or leaves the file exactly as it was.
#
# `opt set` refuses a path that is already present ("remove it first"), so
# changing a value has meant `opt remove` then `opt set` -- two invocations
# with two backups and nothing covering the pair. A set that fails after a
# successful remove loses the option outright, when what was asked for was a
# change. The difference here is one backup, taken before anything is
# touched.
#
# A sibling rather than a --force on `opt set`, deliberately: that refusal
# is a useful guard against a caller clobbering a line somebody wrote by
# hand, and keeping a separate verb keeps the guard.
cmd_opt_replace() {
  local path=${1-} value=${2-}
  [ -n "$path" ] && [ $# -ge 2 ] ||
    die "usage: nixarchy-pkg opt replace <path> <nix-value>"

  valid_path "$path" || die "'$path' is not an option path"

  flat_value "$value"

  begin_write
  [ -f "$APPS" ] || die "no $APPS -- log in again to have it created"
  one_line value
  check_literal "$path" "$value"
  has_opt "$APPS" "$path" ||
    die "$path is not in $APPS -- use 'opt set' to add it"

  # BEFORE anything is touched. This is the whole point of the command.
  guard "$APPS"

  # Keyed on the marker rather than on position: the line is wherever the
  # person moved it to, and the marker is what finds it. Through the
  # environment rather than `awk -v` for the reason cmd_opt_set gives -- -v
  # processes escape sequences, so a Nix value containing a backslash would
  # arrive mangled.
  local tmp; tmp=$(mktemp)
  NIXARCHY_PKG_PATH="$path" NIXARCHY_PKG_VALUE="$value" awk '
    {
      marker = "#@opt " ENVIRON["NIXARCHY_PKG_PATH"]
      if (!done && index($0, marker) > 0 &&
          substr($0, length($0) - length(marker) + 1) == marker) {
        printf "  %s = %s;  %s\n",
          ENVIRON["NIXARCHY_PKG_PATH"], ENVIRON["NIXARCHY_PKG_VALUE"], marker
        done = 1
        next
      }
      print
    }
  ' "$APPS" > "$tmp"

  if ! has_opt "$tmp" "$path"; then
    die "could not find $path to replace after all. Nothing was changed."
  fi

  local why
  if ! why=$(exec 9>&-; nix-instantiate --parse "$tmp" 2>&1 >/dev/null); then
    # One awk rather than `grep … | head -1`: grep exits 1 when nothing
    # matches, and under `pipefail` that killed this function before the
    # die() below could report anything -- the fallback on the next line
    # has never once been reached. `head` closing the pipe could also take
    # grep out with SIGPIPE on a long error, failing a match that DID
    # happen. awk exits 0 either way, and a here-string leaves no pipeline
    # to have a status at all.
    why=$(awk '/^error:/ { print; exit }' <<<"$why")
    die "that value was refused, so nothing was changed. ${why:-nix could not parse the result}"
  fi

  cp "$tmp" "$APPS"   # not mv; see cmd_opt_set (#39)
  committed

  state_with true "replaced $path = $value"
}

cmd_opt() {
  local action=${1-}; shift || true
  case "$action" in
    describe) cmd_opt_describe "$@" ;;
    set)      cmd_opt_set "$@" ;;
    replace)  cmd_opt_replace "$@" ;;
    remove)
      [ $# -gt 0 ] || die "usage: nixarchy-pkg opt remove <path>"
      need nixarchy-opt-remove
      begin_write
      guard "$APPS"
      run_writer nixarchy-opt-remove "$@"
      writer_finished
      ;;
    *) die "opt takes describe, set, replace or remove, not '${action:-nothing}'" ;;
  esac
}

# ---- the system flake -------------------------------------------------
#
# The one place this project writes outside its own selection files, and
# the reason the writes here are appended rather than edited.
#
# `{ a = { x = 1; }; a.y = 2; }` evaluates to `{ a = { x = 1; y = 2; }; }`:
# a path assignment merges with an attrset that already exists. So an
# input is declared by appending ONE top-level line and letting Nix merge
# it, rather than by finding the `inputs { }` block and inserting into it
# -- which would mean matching braces in somebody else's Nix and rewriting
# a region they own and formatted.

# The line the flake's outer attrset opens on. Verified rather than
# assumed: a flake whose outer brace is not a bare `{` at column 0 is
# declined, because appending to the wrong scope would produce a file that
# parses and means something else.
flake_anchor() {
  local file=$1 n
  # One awk rather than `grep -n | head -1 | cut`: `|| true` kept the
  # no-match case alive but swallowed a grep that failed for a real reason,
  # and a SIGPIPE from head closing the pipe would lose a match that did
  # happen -- and an empty answer here means the flake is DECLINED, so a
  # lost match declines a flake that was fine.
  n=$(awk '/^\{$/ { print NR; exit }' "$file")
  [ -n "$n" ] || return 1
  printf '%s' "$n"
}

# Two lists, both read, neither hard-coded.
#
# The flake's own input names are a hard constraint: declaring one twice
# is an error, so a collision is refused.
#
# nixarchy's are a warning, not a refusal, and the difference is measured.
# The installer template hands modules `self.inputs // nixarchy.inputs`,
# and `//` is right-biased, so there a colliding name locks fine and is
# then silently ignored. A flake that adopted nixarchy as one input among
# many typically passes its own `inputs` straight through and shadows
# nothing. Refusing everyone to protect the first group would block
# legitimate names for the larger second one.
#
# Read, because a hand-kept list was wrong before it was used: it had
# twelve names where the lock says seventeen, and the five it missed
# included `nixpkgs`.
flake_names() {
  local lock="${NIXARCHY_FLAKE:-/etc/nixos}/flake.lock"
  [ -r "$lock" ] || return 0
  case "${1-}" in
    own)      jq -r '.nodes[.root].inputs | keys[]' "$lock" 2>/dev/null || true ;;
    nixarchy) jq -r '
        (.nodes[.root].inputs.nixarchy // empty) as $n
        | if ($n | type) == "string"
          then (.nodes[$n].inputs // {} | keys[])
          else empty end
      ' "$lock" 2>/dev/null || true ;;
  esac
  return 0
}

# The useful line out of a nix error, which is not the first one.
#
# Modern nix prints a bare `error:` and then indents the detail under it,
# so the anchored `^error:` that works for nix-instantiate --parse yields
# the prefix and nothing else. Take the first line that carries `error:`
# AND says something after it; fall back to the first non-empty line, so
# an unfamiliar format degrades to nix's words rather than to ours.
nix_why() {
  local file=$1 why
  # Matching nothing is a legitimate answer here, and under
  # `set -euo pipefail` an empty match would otherwise take the whole script
  # down in the middle of a write, with no message at all. This used to say
  # `|| true` on each pipeline, which survived that but equally survived a
  # grep that failed for a real reason, and could still lose a match to
  # SIGPIPE when head closed the pipe on a long log. One awk per branch
  # exits 0 whether or not it matched, and leaves no pipeline to guard.
  why=$(awk '/error:/ {
               sub(/^[[:space:]]*/, ""); sub(/^error:[[:space:]]*/, "")
               if ($0 != "") { print; exit }
             }' "$file")
  [ -n "$why" ] || why=$(awk 'NF { sub(/^[[:space:]]*/, ""); print; exit }' "$file")
  printf '%s' "$why"
}

# What a flake offers, before anything is written. `nix flake show`
# needs no build -- measured at 1.4s on a local flake and 10s for a first
# remote fetch.
#
# It enumerates less than it looks like it does, and the gap is the whole
# reason this reports three lists instead of one. Measured identically on
# nixvim, home-manager and sops-nix:
#
#   nixosModules        {"default": {"type":"nixos-module"}, "<name>": ...}
#   homeManagerModules  {"type": "unknown"}
#
# `nixosModules` is typed and enumerable. Every other module namespace is
# a community convention rather than schema, and comes back as one opaque
# leaf. Those are reported as unreadable BY NAME: an empty list would read
# as "this flake offers none", which is a different and false statement.
#
# A timeout, because a flake using import-from-derivation can make even
# `show` build. Bounded and reported, rather than left hanging.
cmd_flake_show() {
  local ref=${1-} out rc=0
  [ -n "$ref" ] || die "usage: nixarchy-pkg flake show <flakeref>"
  need nix
  # Streams kept apart, unlike run_writer, which merges them deliberately
  # because a writer's output IS prose. This one is a data channel: nix
  # prints progress and warnings on stderr, and folding those into stdout
  # puts banner text in front of the JSON and breaks the parse.
  local err; err=$(mktemp)
  # shellcheck disable=SC2064  # $err is fixed at trap time, deliberately
  trap "rm -f '$err'" RETURN
  out=$(timeout 120 "${NIX[@]}" flake show --json "$ref" 2>"$err") || rc=$?
  if [ "$rc" != 0 ]; then
    local why; why=$(nix_why "$err")
    local not_flake=false
    if [[ $why =~ [Pp]ath\ \'[^\']*flake\.nix\'\ does\ not\ exist ]] &&
       ! grep -Eq 'while (fetching|updating) (the )?(flake )?input ' "$err"; then
      not_flake=true
    fi
    jq -nc --arg ref "$ref" --arg why "${why:-could not inspect $ref}" --argjson nf "$not_flake" \
      '{ok: false, ref: $ref, message: $why} + (if $nf then {notFlake: true} else {} end)'
    return 0
  fi
  # An enumerable namespace is an object of attributes; an opaque one is a
  # single leaf carrying "type". `has("type")` is the whole difference.
  # shortcut: Linux only (uname -m)-linux; a Darwin host needs builtins.currentSystem.
  printf '%s' "$out" | jq -c --arg ref "$ref" --arg sys "$(uname -m)-linux" '
    . as $f
    | {
      ok: true,
      ref: $ref,
      nixosModules:
        (($f.nixosModules // {}) | if has("type") then [] else keys end),
      packages:
        (($f.packages // {}) | if has("type") then [] else (.[$sys] // {} | keys) end),
      overlays:
        (($f.overlays // {}) | if has("type") then [] else keys end),
      otherCount:
        (($f.packages // {}) | if has("type") then 0 else
          (to_entries | map(select(.key != $sys) | .value | length) | add // 0) end),
      opaque:
        ([ "homeManagerModules", "homeManagerModule", "homeModules",
           "darwinModules", "nixDarwinModules", "flakeModules", "modules" ]
         | map(select($f[.] != null
                      and ($f[.] | type) == "object"
                      and ($f[.] | has("type")))))
    }' 2>/dev/null || {
      jq -nc --arg ref "$ref" '{ok: false, ref: $ref, message: "could not read what that flake exposes"}'
    }
}

# One rule for an input name, for add and remove alike: the pattern
# `flake list` parses, so anything declared here is also listed here. Nix
# would also take `'`; nothing is lost by leaving it out. Checked whole,
# because the name goes on into grep, awk and sed -- `add` once looked at
# the first character only, and `remove` at none, so `sub$` removed `sub`
# past the check meant to stop it (#29).
valid_input_name() {
  [[ ${1-} =~ ^[A-Za-z_][A-Za-z0-9_-]*$ ]] ||
    die "'${1-}' is not a usable input name: letters, digits, _ and -, starting with a letter or _. Nothing was changed."
}

valid_path() {
  local path=${1-} part="" mode=bare c i
  [ -n "$path" ] || return 1
  for ((i=0; i<${#path}; i++)); do
    c=${path:i:1}
    if [ "$c" = . ] && [ "$mode" != quoted ]; then
      valid_path_part "$part" || return 1
      part=""; mode=bare
    elif [ "$c" = '"' ]; then
      if [ "$mode" = bare ] && [ -z "$part" ]; then mode=quoted
      elif [ "$mode" = quoted ]; then mode=closed
      else return 1; fi
      part+=$c
    else
      [ "$mode" != closed ] || return 1
      part+=$c
    fi
  done
  [ "$mode" != quoted ] && valid_path_part "$part"
}

valid_path_part() {
  local part=$1 ident_re="^[A-Za-z_][A-Za-z0-9_'-]*$"
  case "$part" in
    if|then|else|assert|with|let|in|rec|inherit|or|\<name\>|\*) return 1 ;;
  esac
  if [[ $part == '"'* ]]; then
    [[ $part == '"'*'"' && $part != *\\* && $part != *\$* && $part != *[$'\001'-$'\037'$'\177']* && $part != *'#@'* ]]
  else
    [[ $part =~ $ident_re ]]
  fi
}

# Declare an input. The riskiest write this project makes -- the system
# flake, where a bad line fails the whole machine's evaluation rather than
# one package -- so it follows cmd_opt_set's discipline below (backup,
# write, validate, restore, report nix's own words) with one step added
# for the lock and one taken BEFORE the write.
#
# The baseline matters more than it looks. Checking only afterwards means
# a flake that was already broken gets blamed on whatever was added last,
# which is this. So the question asked is a delta -- did THIS change it --
# not an absolute.
#
# What is deliberately NOT checked is whether a host still builds.
# Evaluating one costs minutes and proves far more than is at stake: an
# input nothing imports cannot break a host. Parse, resolve, lock.
cmd_flake_add() {
  local nofollows=false noflake=false
  while [ $# -gt 0 ]; do
    case $1 in
      --no-follows) nofollows=true; shift ;;
      --no-flake) noflake=true; nofollows=true; shift ;;
      *) break ;;
    esac
  done
  [ $# -eq 2 ] && [[ $1 != -* ]] && [[ $2 != -* ]] ||
    die "usage: nixarchy-pkg flake add [--no-follows] [--no-flake] <name> <flakeref>"
  local name=$1 ref=$2
  valid_input_name "$name"
  # The ref goes between quotes in the system flake, so it is data or it
  # is refused: a quote, a backslash or ${ in it would write Nix that
  # parses and means something else, and parse and lock would not notice
  # (#29). No real flakeref needs any of them. [[:graph:]] rather than a
  # range like [!-~]: a range is collation order, and under a UTF-8 locale
  # it refused an ordinary path.
  [[ $ref =~ ^[[:graph:]]+$ ]] && [[ $ref != *[\"\\\$\`]* ]] ||
    die "that flakeref has a character a flakeref never needs (quotes, backslash, \$, backtick or whitespace). Nothing was written."
  need nix
  begin_write

  local dir="${NIXARCHY_FLAKE:-/etc/nixos}" file lock
  file="$dir/flake.nix"; lock="$dir/flake.lock"
  [ -w "$file" ] || die "cannot write $file"
  # Before ANY nix call: `nix flake metadata` writes a lock the flake lacks.
  guard "$file" "$lock"

  local at; at=$(flake_anchor "$file") ||
    die "cannot find where $file opens -- its outer { is not on a line of its own, so I do not know where a top-level line would go. Add the input by hand."

  if grep -qE "#@flake-input ${name}\$" "$file"; then
    die "'$name' is already declared here by this tool"
  fi
  if flake_names own | grep -qxF "$name"; then
    die "'$name' is already an input of this flake. Two definitions of one input is an error, so nothing was changed."
  fi

  # A warning, not a refusal. See flake_names.
  local warn=""
  if flake_names nixarchy | grep -qxF "$name"; then
    warn="nixarchy also has an input called '$name'. If this flake hands its modules nixarchy's inputs merged over its own -- the installer's template does -- yours will be locked and then silently ignored. If it passes its own inputs straight through, this is fine."
  fi

  local err; err=$(mktemp)

  if ! timeout -k 10 120 "${NIX[@]}" flake metadata "$dir" >/dev/null 2>"$err" 9>&- 8>&-; then
    die "this flake does not evaluate as it stands, so I have changed nothing rather than add to a broken file: $(nix_why "$err")"
  fi

  # After the outer brace, so it lands at the top level of the flake's own
  # attrset. Nix merges it with whatever `inputs = { ... }` is already
  # there, which is why the existing block is never touched.
  local line="  inputs.${name}.url = \"${ref}\";  #@flake-input ${name}"
  local tmp; tmp=$(mktemp)
  # Through the environment, not -v, which would process escapes in it.
  NIXARCHY_PKG_LINE="$line" NIXARCHY_PKG_EXTRA="$(if $noflake; then printf '  inputs.%s.flake = false;  #@flake-input %s' "$name" "$name"; fi)" \
    awk -v at="$at" 'NR == at { print; print ENVIRON["NIXARCHY_PKG_LINE"];
      if (ENVIRON["NIXARCHY_PKG_EXTRA"] != "") print ENVIRON["NIXARCHY_PKG_EXTRA"]; next } { print }' \
      "$file" > "$tmp"

  if ! nix-instantiate --parse "$tmp" >/dev/null 2>"$err" 9>&- 8>&-; then
    die "that would have left $file unparseable, so nothing was changed: $(nix_why "$err")"
  fi
  cp "$tmp" "$file"   # not mv; see cmd_opt_set (#39)

  if ! timeout -k 10 120 "${NIX[@]}" flake lock "$dir" >/dev/null 2>"$err" 9>&- 8>&-; then
    die "could not lock '$ref', so nothing was changed: $(nix_why "$err")"
  fi

  local follows=false
  if ! $nofollows && jq -e --arg n "$name" '
    (.nodes[.root].inputs.nixpkgs | type) == "string" and
    ((.nodes[.root].inputs[$n]) as $k | ($k | type) == "string" and
      ((.nodes[$k].inputs.nixpkgs // null) | type) == "string")' "$lock" >/dev/null; then
    follows=true
    tmp=$(mktemp)
    NIXARCHY_PKG_LINE="  inputs.${name}.inputs.nixpkgs.follows = \"nixpkgs\";  #@flake-input ${name}" \
      awk -v at="$at" 'NR == at + 1 { print; print ENVIRON["NIXARCHY_PKG_LINE"]; next } { print }' \
        "$file" > "$tmp"
    if ! nix-instantiate --parse "$tmp" >/dev/null 2>"$err" 9>&- 8>&-; then
      die "that would have left $file unparseable, so nothing was changed: $(nix_why "$err")"
    fi
    cp "$tmp" "$file"
    if ! timeout -k 10 120 "${NIX[@]}" flake lock "$dir" >/dev/null 2>"$err" 9>&- 8>&-; then
      die "could not lock '$ref' with nixpkgs follows, so nothing was changed: $(nix_why "$err")"
    fi
  fi

  if ! timeout -k 10 120 "${NIX[@]}" flake metadata "$dir" >/dev/null 2>"$err" 9>&- 8>&-; then
    die "the flake stopped evaluating with '$name' in it, so nothing was changed: $(nix_why "$err")"
  fi
  committed

  # The adapter has not inspected this flake's outputs, so it cannot name
  # a module to import. `flake show` lets the caller see what it offers.
  jq -nc --arg name "$name" --arg ref "$ref" --arg warn "$warn" --argjson follows "$follows" \
    '{ok: true, name: $name, url: $ref, follows: $follows,
      message: (("declared " + $name + " and locked it -- run \u0027nixarchy-pkg flake show " + $ref + "\u0027 to see what it offers")
                + (if $follows then " -- follows this flake\u0027s nixpkgs" else "" end)
                + (if $warn == "" then "" else " -- " + $warn end))}'
}

# Removal refuses rather than succeeds-and-breaks. Taking out a
# declaration something else depends on fails evaluation, which is the one
# thing this must never do quietly.
cmd_flake_remove() {
  local name=${1-}
  [ -n "$name" ] || die "usage: nixarchy-pkg flake remove <name>"
  valid_input_name "$name"
  need nix
  begin_write

  local dir="${NIXARCHY_FLAKE:-/etc/nixos}" file lock
  file="$dir/flake.nix"; lock="$dir/flake.lock"
  [ -w "$file" ] || die "cannot write $file"
  grep -qE "#@flake-input ${name}\$" "$file" ||
    die "no input '$name' declared here by this tool. Nothing was changed."
  # Before ANY nix call: `nix flake metadata` writes a lock the flake lacks.
  guard "$file" "$lock"

  # The same baseline as add: a flake that was already broken is not this
  # removal's fault, and must not look like it (#29).
  local err; err=$(mktemp)
  if ! timeout -k 10 120 "${NIX[@]}" flake metadata "$dir" >/dev/null 2>"$err" 9>&- 8>&-; then
    die "this flake does not evaluate as it stands, so I have changed nothing rather than remove from a broken file: $(nix_why "$err")"
  fi

  # Anything that names it other than the declaration itself -- an import
  # somebody pasted, a specialArgs reference -- in ANY .nix file of the
  # flake, not just flake.nix: a host module handed `inputs` and using
  # inputs.<name> is the case that matters most (#29).
  #
  # A whole Nix identifier, bounded by what cannot be part of one, so that
  # `sub-projects` is not `sub`; `-` and `'` are identifier characters.
  # It stays conservative: the name inside a string or a comment still
  # counts, and the refusal says where, so a false alarm can be removed by
  # hand. -v is safe here: the name was validated above.
  #
  # One find + awk, stopping at the first hit, rather than grep into head:
  # an empty answer here means "go ahead and remove it", so a match lost to
  # a pipe is a declaration removed while something still uses it.
  local used
  used=$(find "$dir" -name '*.nix' -not -path '*/.git/*' -not -path '*/result*' \
    -exec awk -v n="$name" '
      BEGIN { re = "(^|[^A-Za-z0-9_'"'"'-])" n "([^A-Za-z0-9_'"'"'-]|$)" }
      $0 ~ re && $0 !~ ("#@flake-input " n "$") { print FILENAME ":" FNR; exit }' {} +)
  used=${used%%$'\n'*}
  if [ -n "$used" ]; then
    die "'$name' is still referred to at $used, so removing its declaration could break evaluation. Take that reference out first -- or, if that line only mentions the name in a string or a comment, remove the input by hand."
  fi

  if [ -r "$lock" ]; then
    local follower
    # Two shapes, and missing the second is how this check quietly does
    # nothing: a direct dependency is stored as the node name, a string,
    # while a `follows` is stored as a PATH -- ["mine"] -- so comparing
    # against the string alone never matches the case this exists for.
    follower=$(jq -r --arg n "$name" '
      .nodes | to_entries
      | map(select(.value.inputs? // {} | to_entries
                   | any(.value == $n
                         or ((.value | type) == "array" and .value[0] == $n))))
      | map(.key) | map(select(. != "root")) | first // empty' "$lock" 2>/dev/null || true)
    if [ -n "$follower" ]; then
      die "'$follower' follows '$name' in flake.lock, so removing it would break evaluation. Nothing was changed."
    fi
  fi

  local tmp; tmp=$(mktemp)

  # Not `sed -i`: it writes a temp file beside the target and renames it, so
  # although GNU sed copies the mode across, the inode is still replaced --
  # which loses the owner and turns a symlinked flake.nix into a real file.
  # Same reason the other three writers use cp (#39).
  sed -E "/#@flake-input ${name}\$/d" "$file" > "$tmp"

  if ! nix-instantiate --parse "$tmp" >/dev/null 2>"$err" 9>&- 8>&-; then
    die "that would have left $file unparseable, so nothing was changed: $(nix_why "$err")"
  fi
  cp "$tmp" "$file"   # not mv; see cmd_opt_set (#39)
  if ! timeout -k 10 120 "${NIX[@]}" flake lock "$dir" >/dev/null 2>"$err" 9>&- 8>&-; then
    die "could not lock the flake without '$name', so nothing was changed: $(nix_why "$err")"
  fi
  if ! timeout -k 10 120 "${NIX[@]}" flake metadata "$dir" >/dev/null 2>"$err" 9>&- 8>&-; then
    die "the flake stopped evaluating without '$name', so nothing was changed: $(nix_why "$err")"
  fi
  committed

  # nix flake lock prunes the input and its dependencies (Nix 2.35.6).
  # List reads the lock; leaving it would keep the input visible and block re-add.
  jq -nc --arg name "$name" '{ok: true, name: $name, message: ("removed " + $name + " -- the flake still parses, locks and evaluates its metadata; hosts were not evaluated")}'
}

cmd_flake_update() {
  [ $# -eq 1 ] || die "usage: nixarchy-pkg flake update <name>"
  local name=$1
  valid_input_name "$name"
  need nix
  begin_write

  local dir="${NIXARCHY_FLAKE:-/etc/nixos}" file lock key err snap lc ans
  file="$dir/flake.nix"; lock="$dir/flake.lock"
  [ -r "$lock" ] || die "no flake.lock in $dir -- nothing is locked yet. Nothing was changed."
  [ -w "$lock" ] && [ -w "$dir" ] || die "cannot write $lock. Nothing was changed."
  key=$(jq -r --arg n "$name" '.nodes[.root].inputs[$n] // empty | if type == "array" then "follows:" + join("/") else . end' "$lock") ||
    die "cannot read $lock. Nothing was changed."
  [ -n "$key" ] || die "'$name' is not an input of this flake's lock. Nothing was changed."
  case $key in follows:*) die "$name follows ${key#follows:}; update that one. Nothing was changed." ;; esac
  guard "$file" "$lock"
  snap=$(mktemp); cp "$lock" "$snap"
  err=$(mktemp)
  if ! (cd "$dir" && timeout -k 10 120 "${NIX[@]}" flake metadata) >/dev/null 2>"$err" 9>&- 8>&-; then
    die "this flake does not evaluate as it stands, so I have changed nothing rather than update a broken file: $(nix_why "$err")"
  fi
  if ! cmp -s "$snap" "$lock"; then
    die "metadata changed other inputs in flake.lock; update them separately. Nothing was changed."
  fi
  if ! (cd "$dir" && timeout -k 10 120 "${NIX[@]}" flake update "$name") >/dev/null 2>"$err" 9>&- 8>&-; then
    die "could not update $name, so nothing was changed: $(nix_why "$err")"
  fi
  if ! (cd "$dir" && timeout -k 10 120 "${NIX[@]}" flake metadata) >/dev/null 2>"$err" 9>&- 8>&-; then
    die "the flake stopped evaluating after updating '$name', so nothing was changed: $(nix_why "$err")"
  fi
  if cmp -s "$snap" "$lock"; then lc=false; else lc=true; fi
  ans=$(jq -nc --arg name "$name" --argjson lc "$lc" --slurpfile a "$snap" --slurpfile b "$lock" '
    ($a[0]) as $old | ($b[0]) as $new |
    ($old.nodes[$old.nodes[$old.root].inputs[$name]].locked.lastModified // null) as $from |
    ($new.nodes[$new.nodes[$new.root].inputs[$name]].locked.lastModified // null) as $to |
    ([ $new.nodes | to_entries[] | select(.key != "root" and
       (.value.locked.narHash != $old.nodes[.key].locked.narHash)) | .key ]) as $moved |
    ([ $old.nodes | keys[] | . as $key | select($key != "root" and ($new.nodes | has($key) | not)) ]) as $removed |
    (if $from == null then "an unknown date" else ($from | todate[:10]) end) as $fromDate |
    (if $to == null then "an unknown date" else ($to | todate[:10]) end) as $toDate |
    ($new.nodes[$new.root].inputs[$name]) as $named |
    {ok: true, name: $name, changed: ($moved | length > 0), lockChanged: $lc,
     moved: $moved, removed: $removed, from: $from, to: $to,
     message: (if ($moved | length) > 0 then
       (if ($moved | index($named)) == null
        then "updated " + $name + "\u0027s dependencies (" + ($moved | join(", ")) + ")"
        else "updated " + $name end) + ": " + $fromDate + " -> " + $toDate + ". Nothing is built until you apply."
       elif $lc then $name + ": a newer revision with the same contents -- nothing to rebuild"
       else $name + " is already up to date" end)}' 2>"$err") ||
    die "could not read the updated lock. Nothing was changed."
  committed
  printf '%s\n' "$ans"
}

# Root inputs from the lock, plus marked lines not locked yet.
cmd_flake_list() {
  local dir="${NIXARCHY_FLAKE:-/etc/nixos}" file lock source
  file="$dir/flake.nix"; lock="$dir/flake.lock"; source=/dev/null
  [ -r "$file" ] || { jq -nc --arg dir "$dir" '{ok: true, dir: $dir, stale: false, inputs: []}'; return; }
  [ -r "$lock" ] && source="$lock"
  jq -nc --arg dir "$dir" \
    --rawfile marks <(awk '
      /#@flake-input [A-Za-z_][A-Za-z0-9_-]*$/ {
        n = $0; sub(/^.*#@flake-input /, "", n)
        u = ""
        if ($0 ~ "^[[:space:]]*inputs\\." n "\\.url[[:space:]]*=[[:space:]]*\"[^\"]+\";[[:space:]]*#@flake-input " n "$") {
          u = $0; sub(/^[^"]*"/, "", u); sub(/".*/, "", u)
        }
        print n "\t" u
      }' "$file") \
    --slurpfile locks "$source" '
    def original($o; $dir):
      if ($o | type) != "object" then null
      elif (["github", "gitlab", "sourcehut"] | index($o.type)) then
        ($o.type + ":" + $o.owner + "/" + $o.repo
         + (if ($o.ref // "") != "" and ($o.ref | contains("/") | not) and ($o.rev == null)
            then "/" + $o.ref else "" end)
         + (if $o.host != null and $o.host != ({github:"github.com",gitlab:"gitlab.com",sourcehut:"git.sr.ht"}[$o.type])
            then "?host=" + ($o.host | @uri) else "" end))
      elif $o.type == "git" then "git+" + $o.url
      elif $o.type == "tarball" or $o.type == "file" then $o.url
      elif $o.type == "indirect" then $o.id + (if $o.ref then "/" + $o.ref else "" end)
      elif $o.type == "path" then "path:" + (if ($o.path | startswith("/")) then $o.path else $dir + "/" + $o.path end)
      else null end
      | if . == null then null else
          . as $base
          | ([if $o.rev then "rev=" + ($o.rev | @uri) else empty end,
              if $o.type == "git" and $o.ref then "ref=" + ($o.ref | @uri) else empty end,
              if (["github","gitlab","sourcehut"] | index($o.type)) and $o.ref
                 and (($o.ref | contains("/")) or $o.rev) then "ref=" + ($o.ref | @uri) else empty end,
              if $o.dir then "dir=" + ($o.dir | @uri) else empty end] | join("&")) as $q
          | $base + (if $q == "" then "" elif ($base | contains("?")) then "&" + $q else "?" + $q end)
        end;
    ($locks[0] // {}) as $l
    | (reduce ($marks | split("\n")[] | select(length > 0) | split("\t")) as $m
        ({}; .[$m[0]] = (if ($m[1] // "") != "" then $m[1] else (.[ $m[0] ] // "") end))) as $marked
    | (($l.nodes // {})[($l.root // "root")].inputs // {}) as $root
    | {ok: true, dir: $dir, stale: ([$marked | keys[] | select($root[.] == null)] | length > 0),
       inputs: ((($root | keys) + ($marked | keys) | unique | sort) | map(
         . as $name | $root[$name] as $entry
         | (if ($entry | type) == "string" then $l.nodes[$entry] else null end) as $node
         | ($marked | has($name)) as $mine
         | {name: $name,
            url: (if $mine then (if $marked[$name] == "" then null else $marked[$name] end) else original($node.original; $dir) end),
            mine: $mine, flake: ($node.flake != false),
            follows: (if ($entry | type) == "array" then ($entry | join("/")) else null end),
            locked: ($root | has($name)),
            inspectable: (if ($entry | type) == "array" then false
                          elif $mine then ($marked[$name] != "")
                          else original($node.original; $dir) != null end),
            lastModified: ($node.locked.lastModified // null)}))}' \
    || die "could not read $lock"
}

# Where nixarchy-apply copies the selection to. A flake cannot read a file
# outside its own tree, which is why the copy exists at all; comparing the
# two is therefore the honest answer to "what would apply change?", rather
# than anything this script remembers.
flake_base() {
  local flake base
  flake=${NIXARCHY_FLAKE:-/etc/nixos}
  base=$flake
  [ -d "$flake/hosts/$(uname -n)" ] && base="$flake/hosts/$(uname -n)"
  printf '%s' "$base"
}

NIX=(nix --extra-experimental-features 'nix-command flakes')

# base_rel -- "" or "hosts/<host>", matching flake_base.
base_rel() {
  local flake=${NIXARCHY_FLAKE:-/etc/nixos}
  if [ -d "$flake/hosts/$(uname -n)" ]; then printf 'hosts/%s' "$(uname -n)"; fi
}

# imported PART BASE -- apply's generated import file imports it now.
imported() { [ -f "$2/nixarchy-apps.nix" ] && grep -qF "./nixarchy/$1.nix" "$2/nixarchy-apps.nix"; }

# record_for DST -- apply's record file for a flake destination.
record_for() { printf '%s/applied/%s' "$STATE_DIR" "$(printf '%s' "$1" | sha256sum | cut -c1-16)"; }

# edited_in_flake DST -- apply's own test.
edited_in_flake() { local r; r=$(record_for "$1"); [ -f "$r" ] && ! sha256sum <"$1" | cmp -s - "$r"; }

# private_dir VAR PREFIX -- 0700 dir in STATE_DIR, cleaned by on_exit. Never inside $(...).
private_dir() {
  mkdir -p "$STATE_DIR" || die "cannot create $STATE_DIR"
  local d; d=$(mktemp -d -p "$STATE_DIR" "$2.XXXXXX") || die "cannot create a working directory in $STATE_DIR"
  printf -v "$1" '%s' "$d"
}

# snapshot_selection DIR -- cp -L every existing part to DIR/<p>.nix and draft to DIR/packages/.
snapshot_selection() {
  local p f
  mkdir -p "$1/packages" || die "cannot create $1"
  for p in apps services advanced flatsnap; do
    f=$CONFIG_DIR/$p.nix
    [ -e "$f" ] || continue
    [ -r "$f" ] || die "cannot read $f"
    cp -L "$f" "$1/$p.nix" 9>&- 8>&- || die "could not copy $f"
  done
  for f in "$CONFIG_DIR"/packages/*.nix; do
    [ -e "$f" ] || continue
    [ -r "$f" ] || die "cannot read $f"
    cp -L "$f" "$1/packages/" 9>&- 8>&- || die "could not copy $f"
  done
}

# fingerprint DIR -- one sha256 over every .nix in DIR, names included.
fingerprint() {
  ( cd "$1" && find . -type f -name '*.nix' -print0 | sort -z | xargs -0r sha256sum ) |
    sha256sum | cut -d' ' -f1
}

# pins_json DIR -- hashes or empty strings for the four parts in a snapshot.
pins_json() {
  local p args=()
  for p in apps services advanced flatsnap; do
    if [ -f "$1/$p.nix" ]; then args+=(--arg "$p" "$(sha256sum <"$1/$p.nix" | cut -d' ' -f1)")
    else args+=(--arg "$p" ""); fi
  done
  jq -nc "${args[@]}" '{apps:$apps, services:$services, advanced:$advanced, flatsnap:$flatsnap}'
}

# Which channel this machine follows, so the panel can name the OTHER one
# and not offer a request the writer would refuse.
#
# Copied from nixarchy-pkg-add:80-88 rather than asked of
# `nixarchy-channel`, deliberately. The question is not "what is true"
# but "what will the writer that acts on this request decide", and only
# the writer's own parse answers that -- nixarchy-channel is a different
# program, and reports in prose (its :92) with no machine-readable mode.
# A copy pinned to a cited line cannot disagree with it; asking a second
# opinion can.
#
# The flat `inputs.nixpkgs.url` form is read only where the writer's own
# parse finds nothing, which is exactly where the writer says `custom`,
# warns and proceeds; so the panel can never offer a channel the writer
# refuses (#63, companion issue 1). The pipe to `head -1` is gone: it
# would SIGPIPE under pipefail.
#
# Read from the URL, which is what an update resolves, not the lock,
# which is only where it last landed. `custom` is a real answer: a
# reshaped flake lands there, and the panel says so rather than guessing.
machine_channel() {
  local flakedir u
  flakedir="${NIXARCHY_FLAKE:-/etc/nixos}"
  [ -r "$flakedir/flake.nix" ] || { printf custom; return; }
  u=$(sed -nE '/^[[:space:]]*nixpkgs\.url[[:space:]]*=[[:space:]]*"([^"]+)".*/{s//\1/p;q}' "$flakedir/flake.nix")
  [ -n "$u" ] || u=$(sed -nE '/^[[:space:]]*inputs\.nixpkgs\.url[[:space:]]*=[[:space:]]*"([^"]+)".*/{s//\1/p;q}' "$flakedir/flake.nix")
  case "$u" in
    *nixos-unstable*) printf unstable ;;
    *nixos-[0-9][0-9].[0-9][0-9]*) printf stable ;;
    *) printf custom ;;
  esac
}

# Queued changes: marked lines that differ between the selection and the
# copy the flake last saw.
#
# A machine that has never applied has no copy at all. That is not an
# error and not "nothing queued" -- it is everything currently selected,
# and the panel is told which of the two it is looking at.
# A file's LIVE marked lines, indentation and block scaffolding removed.
#
# Live only, and that is the whole point: a row that is commented out on
# both sides is not a queued change, however much its text moved. Topping
# a catalogue up with nixarchy-catalogue-diff --add appends sixteen
# commented rows, and counting those told the user sixteen things were
# waiting to be built when nothing was.
#
# The #@pkgs-begin / #@pkgs-end wrappers are scaffolding pkg-add creates
# on first use rather than choices anyone made, so they go too --
# otherwise picking one package reports three changes.
marked() {
  grep -E '^[[:space:]]*[^#[:space:]].*#@' "$1" 2>/dev/null |
    grep -vE '#@pkgs-(begin|end)' | sed 's/^[[:space:]]*//' || true
}


# twoway A B OUT -- a missing side is empty; diff status 1 means changed.
twoway() {
  local a=$1 b=$2 rc=0
  [ -e "$a" ] || a=/dev/null
  [ -e "$b" ] || b=/dev/null
  if diff "${@:4}" "$a" "$b" >"$3"; then :; else rc=$?; fi
  [ "$rc" -le 1 ] || die "could not compare $1 and $2"
}

# One file row, using the same comparison for parts and drafts.
pending_file() {
  local file=$1 label=$2 src=$3 dst=$4 status=$5 conflict=$6 live=$7
  local a=$src b=$dst unmarked hunk
  [ -e "$a" ] || a=/dev/null
  [ -e "$b" ] || b=/dev/null
  grep -v '#@' "$b" >"$READDIR/dst.u" || :
  grep -v '#@' "$a" >"$READDIR/src.u" || :
  twoway "$READDIR/dst.u" "$READDIR/src.u" "$READDIR/ud"
  unmarked=$(grep -c '^[<>]' "$READDIR/ud" || :)
  [ -n "$unmarked" ] || die "could not count changes in $file"
  twoway "$dst" "$src" "$READDIR/hunk" -u --label "$label (applied)" --label "$label (yours)"
  hunk=$(sed -n '1,200p' "$READDIR/hunk")
  jq -nc --arg file "$file" --arg label "$label" --arg path "$live" \
    --arg status "$status" --arg conflict "$conflict" --argjson unmarked "$unmarked" \
    --arg hunk "$hunk" \
    '{file:$file, label:$label, path:(if $path == "" then null else $path end),
      status:$status, unmarked:$unmarked, hunk:$hunk,
      conflict:(if $conflict == "" then null else $conflict end)}' >>"$READDIR/files.jsonl"
}

cmd_pending() {
  local base p src dst live status conflict rc never=true writing=false f label marked_src
  PENDING=true
  base=$(flake_base)
  [ -d "$base/nixarchy" ] && never=false
  private_dir READDIR pkg-read
  export TMPDIR=$READDIR
  local rpaths rrc=0
  rpaths=$(interrupted) || rrc=$?
  case $rrc in 0) die "$(recovery_message "$rpaths")" ;; 2) writing=true ;; esac
  snapshot_selection "$READDIR"
  if [ -e "$TXN/open" ]; then
    rrc=0; rpaths=$(interrupted) || rrc=$?
    case $rrc in
      0) die "$(recovery_message "$rpaths")" ;;
      *) writing=true ;;   # 1: a live write committed during the probe
    esac
  fi
  : >"$READDIR/files.jsonl"
  : >"$READDIR/marked.jsonl"
  : >"$READDIR/changes.jsonl"
  : >"$READDIR/lines.jsonl"

  for p in apps services advanced flatsnap; do
    src=$READDIR/$p.nix
    dst=$base/nixarchy/$p.nix
    live=""; [ -e "$CONFIG_DIR/$p.nix" ] && live=$CONFIG_DIR/$p.nix
    [ ! -e "$dst" ] || [ -r "$dst" ] || die "cannot read $dst"
    status=""; conflict=""; rc=0
    if [ -f "$src" ] && [ -e "$dst" ]; then
      if cmp -s "$src" "$dst"; then rc=0; else rc=$?; fi
      [ "$rc" -le 1 ] || die "could not compare $src and $dst"
    fi
    if [ -f "$src" ]; then
      if ! imported "$p" "$base" || [ ! -e "$dst" ]; then status=new
      elif [ "$rc" = 1 ]; then status=modified
      fi
    elif imported "$p" "$base"; then status=dropped
    fi
    [ -n "$status" ] || continue
    if [ -f "$src" ] && [ -e "$dst" ] && [ "$rc" = 1 ] && edited_in_flake "$dst"; then
      conflict=overwrite
    fi
    pending_file "$p" "$p.nix" "$src" "$dst" "$status" "$conflict" "$live"
    marked "$dst" >"$READDIR/dst.marked"
    marked "$src" >"$READDIR/src.marked"
    marked_src=$src; [ -f "$src" ] || marked_src=/dev/null
    awk -v file="$p" '/^[[:space:]]*[^#[:space:]].*#@/ && !/#@pkgs-(begin|end)/ {
      printf "{\"file\":\"%s\",\"index\":%d,\"lineNo\":%d}\n", file, ++n, NR
    }' "$marked_src" >>"$READDIR/lines.jsonl"
    twoway "$READDIR/dst.marked" "$READDIR/src.marked" "$READDIR/marked.diff" \
      --old-line-format=$'%dn\t-%L' --new-line-format=$'%dn\t+%L' --unchanged-line-format=''
    jq -Rsc --arg file "$p" '
      def marker: . as $line | capture("#@(?<t>[a-z-]*)[ \t]+(?<n>[^ \t]+)")
        | if .t == "opt" then .t + ":" + ($line | capture("#@opt[ \\t]+(?<n>.*[^ \\t])[ \\t]*$").n)
          else .t + ":" + .n end;
      split("\n") | map(select(length > 0)) | .[] | split("\t") |
      {file:$file, index:(.[0] | tonumber), sign:.[1][0:1], line:.[1][1:] | rtrimstr("\n")} |
      . + {marker:(try (.line | marker) catch .line)}
    ' "$READDIR/marked.diff" >>"$READDIR/marked.jsonl"
  done

  for f in "$READDIR"/packages/*.nix; do
    [ -f "$f" ] || continue
    label=packages/${f##*/}
    dst=$base/nixarchy/$label
    live=""; [ -e "$CONFIG_DIR/$label" ] && live=$CONFIG_DIR/$label
    [ ! -e "$dst" ] || [ -r "$dst" ] || die "cannot read $dst"
    status=new; conflict=""
    if [ -e "$dst" ]; then
      if cmp -s "$f" "$dst"; then rc=0; else rc=$?; fi
      [ "$rc" -le 1 ] || die "could not compare $f and $dst"
      [ "$rc" = 0 ] && continue
      status=modified
      edited_in_flake "$dst" && conflict=blocks
    fi
    pending_file "$label" "$label" "$f" "$dst" "$status" "$conflict" "$live"
  done

  jq -sc --slurpfile lines "$READDIR/lines.jsonl" '
    group_by([.file, .marker]) | map(
      (map(select(.sign == "-"))) as $minus |
      (map(select(.sign == "+"))) as $plus |
      [range(0; [$minus|length, $plus|length] | max) as $i |
        if $i < ($plus|length) then
          $plus[$i] as $row |
          $row + {change:(if $i < ($minus|length) then "modified"
                          elif ($row.marker | startswith(":")) then "on" else "added" end)}
        else $minus[$i] + {change:(if ($minus[$i].marker | startswith(":")) then "off" else "removed" end)} end
      ]) | add // [] | .[] |
      {marker, file, line, change,
       lineNo:(if .sign == "+" then
         (.["file"] as $file | .index as $index |
          [$lines[] | select(.file == $file and .index == $index) | .lineNo] | first // null)
         else null end)}
  ' "$READDIR/marked.jsonl" >"$READDIR/changes.jsonl"

  local fingerprint pins drafts
  fingerprint=$(fingerprint "$READDIR")
  pins=$(pins_json "$READDIR")
  drafts=$(find "$READDIR/packages" -maxdepth 1 -type f -name '*.nix' -printf 'packages/%f\n' | sort | jq -Rsc 'split("\n") | map(select(length > 0))')
  PENDING=false
  jq -n --slurpfile files "$READDIR/files.jsonl" --slurpfile changes "$READDIR/changes.jsonl" \
    --argjson never "$never" --argjson writing "$writing" --arg base "$base" \
    --arg fingerprint "$fingerprint" --argjson pins "$pins" --argjson drafts "$drafts" \
    --arg apps "$([ ! -e "$CONFIG_DIR/apps.nix" ] || printf '%s' "$CONFIG_DIR/apps.nix")" \
    --arg services "$([ ! -e "$CONFIG_DIR/services.nix" ] || printf '%s' "$CONFIG_DIR/services.nix")" \
    --arg advanced "$([ ! -e "$CONFIG_DIR/advanced.nix" ] || printf '%s' "$CONFIG_DIR/advanced.nix")" \
    --arg flatsnap "$([ ! -e "$CONFIG_DIR/flatsnap.nix" ] || printf '%s' "$CONFIG_DIR/flatsnap.nix")" '
    ($files | map(.file as $name | . + {explained:(.status == "modified" and .unmarked == 0 and
                                  any($changes[]; .file == $name))})) as $f |
    {ok:true, neverApplied:$never, base:$base, writing:$writing,
     count:($changes|length), changes:$changes, files:$f,
     total:(($changes|length) + ($f | map(select(.explained|not)) | length)),
     fingerprint:$fingerprint, pins:$pins,
     sources:({apps:$apps, services:$services, advanced:$advanced, flatsnap:$flatsnap} |
       with_entries(.value |= if . == "" then null else . end)),
     unpinned:{drafts:$drafts, flake:true}}
  '
}

check_answer() {
  local ifd
  note='Checked evaluation only, not a build or a switch. This is evidence, not a guarantee: apply evaluates again for real.'
  ifd=$("${NIX[@]}" config show allow-import-from-derivation 9>&- 8>&- 2>/dev/null || :)
  [ "$ifd" != true ] || note="$note With import-from-derivation on, evaluating may have built some inputs."
  CHECKING=false
  jq -nc --arg host "$host" --arg verdict "$verdict" --arg fingerprint "$fingerprint" \
    --argjson pins "$pins" --argjson unpinned "$unpinned" --argjson blocked "$blocked" \
    --arg note "$note" --arg reason "$reason" --arg drvPath "$drvPath" \
    --arg summary "$summary" --arg error "$error" --argjson at "$at" \
    --argjson dryRun "${dry_run:-null}" --arg dryRunError "$dry_error" \
    --argjson drySet "$dry_set" --arg checkError "$check_error" '
      if $checkError != "" then {ok:false, error:$checkError}
      else {ok:true, host:$host, verdict:$verdict, fingerprint:$fingerprint,
            pins:$pins, unpinned:$unpinned, blocked:$blocked, note:$note}
        + (if $reason != "" then {reason:$reason} else {} end)
        + (if $drvPath != "" then {drvPath:$drvPath} else {} end)
        + (if $summary != "" then {summary:$summary} else {} end)
        + (if $error != "" then {error:$error, at:$at} else {} end)
        + (if $drySet then {dryRun:$dryRun}
           + (if $dryRunError != "" then {dryRunError:$dryRunError} else {} end)
           else {} end)
      end'
  exit 0
}

# Replace exact path text; a regex could rewrite an unrelated store path.
check_replace() {
  local from=$1 to=$2 rest=$error out=""
  [ -n "$from" ] || return 0
  while [[ $rest == *"$from"* ]]; do
    out+=${rest%%"$from"*}$to
    rest=${rest#*"$from"}
  done
  error=$out$rest
}

check_failure() {
  local f name path
  verdict=fails
  if $reads_rev; then
    verdict=unknown
    reason='the check failed, but this flake reads its own git revision, which a copy does not have -- apply may still work'
  fi
  error=$(cat "$CHECKDIR/err")
  for f in "$cb/nixarchy/packages"/*.nix; do
    [ -f "$f" ] || continue
    name=${f##*/}
    [ -e "$CHECKDIR/snap/packages/$name" ] && continue
    path=${br:+$br/}nixarchy/packages/$name
    [ -z "$root" ] || check_replace "$root/$path" "$base/nixarchy/packages/$name"
    check_replace "$copy/$path" "$base/nixarchy/packages/$name"
  done
  [ -z "$root" ] || check_replace "$root/${br:+$br/}nixarchy/packages/" "$CONFIG_DIR/packages/"
  check_replace "$copy/${br:+$br/}nixarchy/packages/" "$CONFIG_DIR/packages/"
  [ -z "$root" ] || check_replace "$root/${br:+$br/}nixarchy/" "$CONFIG_DIR/"
  check_replace "$copy/${br:+$br/}nixarchy/" "$CONFIG_DIR/"
  [ -z "$root" ] || check_replace "$root/" "$flake/"
  check_replace "$copy/" "$flake/"
  printf '%s\n' "$error" >"$CHECKDIR/rewritten"
  error=$(tail -n 200 "$CHECKDIR/rewritten")
  summary=$(awk '
    /^[[:space:]]*error:[[:space:]]*[^[:space:]]/ {
      s=$0; sub(/^[[:space:]]*error:[[:space:]]*/, "", s); last=s
    }
    /^[[:space:]]*error:[[:space:]]*$/ { after=1; following=""; next }
    after && following=="" && /[^[:space:]]/ {
      following=$0; sub(/^[[:space:]]*/, "", following); sub(/[[:space:]]*$/, "", following)
    }
    END { if (last != "") print last; else print following }
  ' "$CHECKDIR/rewritten")
  at=$(jq -nc --arg e "$error" --arg dir "$CONFIG_DIR/" '
    ([ $e | scan("[^[:space:]:]+\\.nix:[0-9]+:") |
       select(startswith($dir)) |
       capture("^(?<p>.*\\.nix):(?<n>[0-9]+):$") |
       {file:(.p | ltrimstr($dir)), line:(.n | tonumber)} ] | last) //
    ([ $e | scan("In '\''[^'\'']+\\.nix'\''") |
       ltrimstr("In '\''") | rtrimstr("'\''") |
       select(startswith($dir)) | {file:ltrimstr($dir), line:null} ] | last) // null
  ')
}

check_dry_run() {
  local rc=0
  setsid timeout 900 "${NIX[@]}" build --dry-run "$drvPath^*" \
    >"$CHECKDIR/dry.out" 2>"$CHECKDIR/dry" 9>&- 8>&- &
  CHILD=$!
  wait "$CHILD" || rc=$?
  CHILD=""
  dry_set=true
  dry_run=null
  dry_error=""
  if [ "$rc" = 0 ]; then
    dry_run=$(awk '
      /will be built/ {
        if (match($0, /these [0-9]+ derivations/)) {
          found=1; t=substr($0, RSTART, RLENGTH); gsub(/[^0-9]/, "", t); build=t+0
        } else if (/this derivation/) { found=1; build=1 }
      }
      /will be fetched/ {
        if (match($0, /these [0-9]+ paths/)) {
          found=1; t=substr($0, RSTART, RLENGTH); gsub(/[^0-9]/, "", t); fetch=t+0
        } else if (/this path/) { found=1; fetch=1 }
        if (match($0, /\([0-9.]+ (B|KiB|MiB|GiB) download/)) {
          t=substr($0, RSTART+1, RLENGTH-10); split(t, a, " ")
          factor=(a[2]=="GiB" ? 1024 : a[2]=="MiB" ? 1 : a[2]=="KiB" ? 1/1024 : 1/1048576)
          size=a[1]*factor
        }
      }
      END {
        if (NR && !found) exit 1
        printf "{\"build\":%d,\"fetch\":%d,\"downloadMiB\":%.2f}", build, fetch, size
      }
    ' "$CHECKDIR/dry" 2>/dev/null) || dry_run=null
  fi
  if [ "$dry_run" = null ]; then
    dry_error=$(sed -n '1p' "$CHECKDIR/dry")
    if [ -z "$dry_error" ]; then
      if [ "$rc" = 0 ]; then dry_error='could not parse the dry run'
      else dry_error="dry run exited $rc"; fi
    fi
  fi
}

# Guard every directory check may write beneath, including absent components.
check_symlinks() {
  local dir=$1 rel=$2 f
  if [ -n "$rel" ]; then
    for f in hosts "$rel" "$rel/nixarchy" "$rel/nixarchy/packages"; do
      if [ -L "$dir/$f" ]; then
        reason="the flake's nixarchy directory is a symlink -- the check will not write through it"
        check_answer
      fi
    done
  else
    for f in nixarchy nixarchy/packages; do
      if [ -L "$dir/$f" ]; then
        reason="the flake's nixarchy directory is a symlink -- the check will not write through it"
        check_answer
      fi
    done
  fi
}

# The five lines the options cache was built from. A change in the last two
# (lock, running generation) marks the cache stale; the first three decide
# whether it is this flake's at all.
options_stamp() {
  local flake=$1 host=$2 user=$3 lock_hash="" system_hash=""
  [ ! -f "$flake/flake.lock" ] || lock_hash=$(sha256sum "$flake/flake.lock" | awk '{print $1}')
  [ ! -e /run/current-system ] || system_hash=$(readlink -f /run/current-system)
  printf '%s\n' "$(readlink -f "$flake")" "$host" "$user" "$lock_hash" "$system_hash" |
    sha256sum | awk '{print $1}'
}

# options_resolve -- sets OPT_DIR (the published generation, resolved once so
# one answer never mixes two), OPT_STALE and OPT_JSON, the `options` object
# every answer carries. A cache built for another flake, host or user is not
# used at all: OPT_DIR stays empty and the source is "system".
OPT_DIR=""
OPT_STALE=false
OPT_JSON='{"source":"system","stale":false,"builtAt":null,"user":null,"homeManager":null,"perUser":null}'
options_resolve() {
  local d flake host user meta
  OPT_DIR=""; OPT_STALE=false
  OPT_JSON='{"source":"system","stale":false,"builtAt":null,"user":null,"homeManager":null,"perUser":null}'
  d=$(readlink -f "$CACHE_DIR/options" 2>/dev/null) || return 0
  [ -f "$d/meta.json" ] && [ -f "$d/system.json" ] || return 0
  meta=$(cat "$d/meta.json" 2>/dev/null) || return 0
  flake=${NIXARCHY_FLAKE:-/etc/nixos}; host=$(uname -n); user=$(id -un)
  jq -e --arg f "$(readlink -f "$flake")" --arg h "$host" --arg u "$user" \
    '.flake == $f and .host == $h and .user == $u' <<<"$meta" >/dev/null 2>&1 || return 0
  OPT_DIR=$d
  [ "$(jq -r .stamp <<<"$meta")" = "$(options_stamp "$flake" "$host" "$user")" ] || OPT_STALE=true
  OPT_JSON=$(jq -c --argjson stale "$OPT_STALE" \
    '{source:"flake", stale:$stale, builtAt, user, homeManager, perUser}' <<<"$meta")
}

cmd_options_refresh() {
  local flake=${NIXARCHY_FLAKE:-/etc/nixos} host user rc=0 started seconds built_at \
    gen old d stamp counts
  need nix
  host=$(uname -n)
  [ -f "$flake/flake.nix" ] || die "no flake at $flake"
  user=$(id -un)
  [[ $user =~ ^[a-z_][a-z0-9_-]*$ ]] || die "invalid user name: $user"
  mkdir -p "$STATE_DIR" || die "cannot create $STATE_DIR"
  exec 6>>"$STATE_DIR/pkg-options.lock" || die "cannot open the options lock"
  flock -n 6 || die "options are already being read"
  [ ! -e "$TXN/open" ] || die 'a write is in progress or was interrupted -- try again, or run recover'
  OPTIONS_READING=true
  private_dir OPTSDIR pkg-options
  export TMPDIR=$OPTSDIR
  stamp=$(options_stamp "$flake" "$host" "$user")
  started=$(date +%s%3N)
  setsid timeout 300 "${NIX[@]}" eval --json --no-write-lock-file \
    "$flake#nixosConfigurations.\"$host\"" --apply "${DISCOVER//@USER@/$user}" \
    >"$OPTSDIR/out.json" 2>"$OPTSDIR/err" 9>&- 8>&- 6>&- &
  CHILD=$!
  wait "$CHILD" || rc=$?
  CHILD=""
  if [ "$rc" = 124 ]; then die 'timed out after 5 minutes'; fi
  if [ "$rc" != 0 ]; then
    if grep -q 'does not provide attribute.*nixosConfigurations' "$OPTSDIR/err"; then
      die "this flake has no nixosConfigurations.$host"
    fi
    die "$(nix_why "$OPTSDIR/err")"
  fi
  built_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  seconds=$(jq -n --argjson start "$started" --argjson end "$(date +%s%3N)" '($end - $start) / 1000')
  mkdir -p "$CACHE_DIR/options.d" || die "cannot create $CACHE_DIR/options.d"
  gen=$CACHE_DIR/options.d/$(date +%s).$$
  mkdir "$gen" || die "cannot create $gen"
  OPTSGEN=$gen
  jq -e '[.nixos[], .home[]?] | all(has("name") and has("type"))' "$OPTSDIR/out.json" >/dev/null ||
    die 'could not read options from the flake'
  jq -c '.nixos | map({key:.name, value:{type, description, default, example, declarations, readOnly}}) | from_entries' \
    "$OPTSDIR/out.json" >"$gen/system.json"
  if jq -e '.home != null' "$OPTSDIR/out.json" >/dev/null; then
    jq -c '.home | map({key:.name, value:{type, description, default, example, declarations, readOnly}}) | from_entries' \
      "$OPTSDIR/out.json" >"$gen/user.json"
  fi
  jq -r '
    def val(x):
      if x == null then "(none)"
      elif (x | type) == "object" then (x.text // (x | tostring))
      else (x | tostring) end;
    (.nixos[] | [., "system", "NIXOS OPTION  "]),
    (.home[]? | [., "user", "HOME MANAGER OPTION  "]) |
    .[0] as $v | .[1] as $scope | .[2] as $heading | $v.name as $k |
    ["opt", $k,
      (($v.description // "") | gsub("[\n\t ]+"; " ") | .[0:110]),
      ($v.type // ""),
      ($heading + $k
        + "\n\ntype:     " + ($v.type // "?")
        + "\ndefault:  " + val($v.default)
        + (if $v.example == null then "" else "\nexample:  " + val($v.example) end)
        + "\n\n" + ($v.description // "(undocumented)")
        + "\n\ndeclared in:\n  " + (($v.declarations // []) | join("\n  "))),
      $scope] | @tsv' "$OPTSDIR/out.json" >"$gen/rows.tsv"
  counts=$(jq -c '{system:(.nixos | length), user:(.home // [] | length)}' "$OPTSDIR/out.json")
  jq -nc --arg builtAt "$built_at" --arg host "$host" --arg user "$user" \
    --arg flake "$(readlink -f "$flake")" --argjson data "$(jq -c '{homeManager,users,perUser}' "$OPTSDIR/out.json")" \
    --argjson counts "$counts" --argjson seconds "$seconds" --arg stamp "$stamp" \
    '{builtAt:$builtAt,host:$host,user:$user,flake:$flake,homeManager:$data.homeManager,users:$data.users,perUser:$data.perUser,counts:$counts,seconds:$seconds,stamp:$stamp}' \
    >"$gen/meta.json"
  old=$(readlink -f "$CACHE_DIR/options" 2>/dev/null || :)
  rm -f -- "$CACHE_DIR/options.tmp" || die 'cannot clear options.tmp'
  ln -s "$gen" "$CACHE_DIR/options.tmp" || die 'cannot create options.tmp'
  mv -T "$CACHE_DIR/options.tmp" "$CACHE_DIR/options" || die 'cannot publish options'
  OPTSGEN=""
  for d in "$CACHE_DIR"/options.d/*; do
    [ -e "$d" ] || continue
    [ "$d" = "$gen" ] || [ "$(readlink -f "$d")" = "$old" ] || rm -rf -- "$d" || :
  done
  OPTIONS_READING=false
  jq -nc --arg host "$host" --arg user "$user" --arg flake "$flake" \
    --argjson data "$(jq -c '{homeManager,perUser}' "$OPTSDIR/out.json")" \
    --argjson counts "$counts" --argjson seconds "$seconds" \
    '{ok:true,source:"flake",host:$host,user:$user,homeManager:$data.homeManager,perUser:$data.perUser,counts:$counts,seconds:$seconds,message:("read \($counts.system) system and \($counts.user) user options from " + $flake)}'
}

cmd_options() {
  [ "$#" = 1 ] && [ "$1" = refresh ] || die 'options takes refresh'
  cmd_options_refresh
}

cmd_check() {
  local flake=${NIXARCHY_FLAKE:-/etc/nixos} host base br copy cb root="" p f name imports rc=0 \
    verdict=unknown reason="" drvPath="" summary="" error="" at=null dry_run="" dry_error="" \
    dry_set=false check_error="" fingerprint="" pins='{}' unpinned='{"drafts":[],"flake":true}' \
    blocked='[]' note="" dry_requested=false reads_rev=false
  case "${1-}" in
    "") [ "$#" = 0 ] || die "check takes only --dry-run" ;;
    --dry-run) [ "$#" = 1 ] || die "check takes only --dry-run"; dry_requested=true ;;
    *) die "check takes only --dry-run" ;;
  esac
  need nix
  host=$(uname -n)
  [ -f "$flake/flake.nix" ] || die "no flake at $flake"
  mkdir -p "$STATE_DIR" || die "cannot create $STATE_DIR"
  exec 8>"$STATE_DIR/pkg-check.lock" || die "cannot open the check lock"
  flock -n 8 || die "a check is already running"
  CHECKING=true
  for f in "$STATE_DIR"/pkg-check.*/; do
    [ -d "$f" ] || continue
    chmod -R u+w "$f" 2>/dev/null || :
    rm -rf "$f" 2>/dev/null || :
  done
  if [ -e "$TXN/open" ]; then
    reason='a write is in progress or was interrupted -- try again, or run recover'
    check_answer
  fi
  private_dir CHECKDIR pkg-check
  export TMPDIR=$CHECKDIR
  snapshot_selection "$CHECKDIR/snap"
  fingerprint=$(fingerprint "$CHECKDIR/snap")
  pins=$(pins_json "$CHECKDIR/snap")
  unpinned=$(find "$CHECKDIR/snap/packages" -maxdepth 1 -type f -name '*.nix' -printf 'packages/%f\n' |
    sort | jq -Rsc '{drafts:(split("\n") | map(select(length > 0))), flake:true}')
  base=$(flake_base); br=$(base_rel)
  check_symlinks "$flake" "$br"
  : >"$CHECKDIR/blocked.jsonl"
  for f in "$CHECKDIR/snap/packages"/*.nix; do
    [ -f "$f" ] || continue
    name=${f##*/}
    [ -f "$base/nixarchy/packages/$name" ] || continue
    if cmp -s "$f" "$base/nixarchy/packages/$name"; then rc=0; else rc=$?; fi
    [ "$rc" -le 1 ] || die "could not compare $f and $base/nixarchy/packages/$name"
    if [ "$rc" = 1 ] && edited_in_flake "$base/nixarchy/packages/$name"; then
      jq -nc --arg label "packages/$name" '{label:$label, conflict:"blocks"}' >>"$CHECKDIR/blocked.jsonl"
    fi
  done
  blocked=$(jq -s . "$CHECKDIR/blocked.jsonl")
  if [ -e "$flake/.git" ]; then
    rc=0
    git -C "$flake" grep -lE 'self\.(rev|shortRev|dirtyRev|dirtyShortRev|lastModified|lastModifiedDate)\b' -- '*.nix' \
      >"$CHECKDIR/git.out" 2>"$CHECKDIR/git.err" 9>&- 8>&- || rc=$?
    # Most flakes set configurationRevision from self.rev; a copy only
    # loses the revision, so a pass still counts and only a failure is
    # in doubt (check_failure).
    [ "$rc" != 0 ] || reads_rev=true
    if [ "$rc" -gt 1 ]; then reason="git failed: $(sed -n '1p' "$CHECKDIR/git.err")"; check_answer; fi
  fi
  if [ -f "$flake/flake.lock" ] && jq -e \
    '[.nodes[]? | .locked? // empty | select(.type=="path" and ((.path // "") | startswith("/") | not))] | length > 0' \
    "$flake/flake.lock" >/dev/null 2>&1; then
    reason='this flake has a relative path input; a copy would not resolve it'
    check_answer
  fi
  if [ -e "$flake/.git" ]; then
    git -C "$flake" ls-files -s >"$CHECKDIR/git.index" 2>"$CHECKDIR/git.err" 9>&- 8>&- ||
      { reason="git failed: $(sed -n '1p' "$CHECKDIR/git.err")"; check_answer; }
    if grep -q '^160000' "$CHECKDIR/git.index"; then
      reason='this flake has git submodules; the check does not copy them'
      check_answer
    fi
  fi
  copy=$CHECKDIR/flake; cb=$copy${br:+/$br}
  mkdir -p "$copy" || { reason="could not copy the flake: cannot create $copy"; check_answer; }
  if [ -e "$flake/.git" ]; then
    if { git -C "$flake" ls-files -z 9>&- 8>&- |
       while IFS= read -r -d '' f; do
         if [ -e "$flake/$f" ] || [ -L "$flake/$f" ]; then printf '%s\0' "$f"; fi
       done | tar -C "$flake" --null --no-recursion -T - -cf - 9>&- 8>&- | tar -C "$copy" -xf - 9>&- 8>&-; } \
       2>"$CHECKDIR/cp.err"; then :
    else reason="could not copy the flake: $(sed -n '1p' "$CHECKDIR/cp.err")"; check_answer; fi
    check_symlinks "$copy" "$br"
    if [ -d "$base/nixarchy" ]; then
      mkdir -p "$cb/nixarchy" || { reason="could not copy the flake: cannot create $cb/nixarchy"; check_answer; }
      if cp -a "$base/nixarchy/." "$cb/nixarchy/" 2>"$CHECKDIR/cp.err" 9>&- 8>&-; then :
      else reason="could not copy the flake: $(sed -n '1p' "$CHECKDIR/cp.err")"; check_answer; fi
    fi
  elif cp -a "$flake/." "$copy/" 2>"$CHECKDIR/cp.err" 9>&- 8>&-; then :
  else reason="could not copy the flake: $(sed -n '1p' "$CHECKDIR/cp.err")"; check_answer; fi
  check_symlinks "$copy" "$br"
  mkdir -p "$cb/nixarchy/packages" || die "cannot create $cb/nixarchy/packages"
  imports=""
  for p in apps services advanced flatsnap; do
    f=$CHECKDIR/snap/$p.nix
    [ -f "$f" ] || continue
    rm -f "$cb/nixarchy/$p.nix" || die "cannot replace $cb/nixarchy/$p.nix"
    cp "$f" "$cb/nixarchy/$p.nix" 9>&- 8>&- || die "cannot copy $f"
    imports="$imports ./nixarchy/$p.nix"
  done
  for f in "$CHECKDIR/snap/packages"/*.nix; do
    [ -f "$f" ] || continue
    rm -f "$cb/nixarchy/packages/${f##*/}" || die "cannot replace ${f##*/}"
    cp "$f" "$cb/nixarchy/packages/${f##*/}" 9>&- 8>&- || die "cannot copy $f"
  done
  rm -f "$cb/nixarchy-apps.nix" || die "cannot replace $cb/nixarchy-apps.nix"
  printf '# Generated by nixarchy-apply. Do not edit -- your files\n# are ~/.config/nixarchy/{apps,services,advanced,flatsnap}.nix and\n# this is regenerated from them on every apply.\n{\n  imports = [%s ];\n}\n' \
    "$imports" >"$cb/nixarchy-apps.nix" || die "cannot write $cb/nixarchy-apps.nix"

  rc=0
  setsid timeout 300 "${NIX[@]}" flake metadata --json "path:$copy" \
    >"$CHECKDIR/meta" 2>"$CHECKDIR/err" 9>&- 8>&- &
  CHILD=$!
  wait "$CHILD" || rc=$?
  CHILD=""
  if [ "$rc" != 0 ]; then check_failure; check_answer; fi
  root=$(jq -r .path "$CHECKDIR/meta")
  rc=0
  setsid timeout 300 "${NIX[@]}" eval --json "path:$copy#nixosConfigurations" --apply "c: builtins.hasAttr \"$host\" c" \
    >"$CHECKDIR/out" 2>"$CHECKDIR/err" 9>&- 8>&- &
  CHILD=$!
  wait "$CHILD" || rc=$?
  CHILD=""
  if [ "$rc" != 0 ]; then
    if grep -q 'does not provide attribute' "$CHECKDIR/err"; then die 'this flake has no nixosConfigurations'; fi
    check_failure; check_answer
  fi
  if [ "$(cat "$CHECKDIR/out")" = false ]; then die "this flake has no nixosConfigurations.$host"; fi
  rc=0
  setsid timeout 900 "${NIX[@]}" eval --raw \
    "path:$copy#nixosConfigurations.\"$host\".config.system.build.toplevel.drvPath" \
    >"$CHECKDIR/out" 2>"$CHECKDIR/err" 9>&- 8>&- &
  CHILD=$!
  wait "$CHILD" || rc=$?
  CHILD=""
  if [ "$rc" = 124 ]; then verdict=unknown; reason='timed out after 15 minutes'
  elif [ "$rc" != 0 ]; then check_failure
  else verdict=evaluates; drvPath=$(cat "$CHECKDIR/out")
  fi
  if [ "$verdict" = evaluates ] && $dry_requested; then check_dry_run; fi
  snapshot_selection "$CHECKDIR/snap2"
  if [ "$(fingerprint "$CHECKDIR/snap2")" != "$fingerprint" ] || [ -e "$TXN/open" ]; then
    verdict=superseded
  fi
  check_answer
}

# Copy the selection into the flake and rebuild.
#
# This is the one command here that changes the machine, and it only ever
# runs on an explicit key.
#
# `--yes --no-preview` answers nixarchy-apply's two questions (nixarchy
# #769). This used to guess them on stdin, and the guess needed a belt: a
# grep for "Not switching." that, piped under `pipefail`, missed the phrase
# every time the log passed the pipe buffer -- and reported "applied" (#26).
# With the flags there is nothing left to decline. A nixarchy too old to
# know them fails at once with its usage line, which is reported as-is.
#
# pkexec: nh elevates itself, and a QML Process has no tty for a password.
# Omarchy runs a polkit agent as an always-loaded service plugin, so pkexec
# puts the prompt on screen in the same shell the panel lives in.
#
# The log is STREAMED, line by line as the build prints it, through awk:
# it strips terminal escapes (the panel draws plain text, and nh colours
# even into a pipe), keeps only the last redraw of a carriage-return
# progress line, flushes every line, and ends even an unterminated last
# line with a newline so the record below is always alone on its own.
# Not `sed -u`: ending the stream on a newline needs `$a\`, and `$` makes
# sed hold every line until the next one arrives, to know which is last.
#
# The last line is the one the panel parses, wrapped in a key a build log
# cannot plausibly print, so a line of build output shaped like a result
# is never taken for the end of the apply.
cmd_apply() {
  need nixarchy-apply
  local statuses rc filt pin pins=() flag
  while [ $# -gt 0 ]; do
    case $1 in
      --pin)
        pin=${2-}
        [[ $pin =~ ^(apps|services|advanced|flatsnap)=([0-9a-f]{64})?$ ]] \
          || die "--pin takes <apps|services|advanced|flatsnap>=<64 hex digits, or nothing>, not '$pin'"
        pins+=(--expect-sha256 "$pin"); shift 2 ;;
      *) die "apply takes only --pin <part>=<sha256>, not '$1'" ;;
    esac
  done
  local rpaths rrc=0 refuse=""
  rpaths=$(interrupted) || rrc=$?
  case $rrc in
    0) refuse=$(recovery_message "$rpaths") ;;
    2) refuse="a write is in progress or was interrupted -- try again in a moment" ;;
  esac
  if [ -n "$refuse" ]; then
    jq -nc --arg m "$refuse" '{nixarchyPkgApply: {ok: false, exit: null, message: $m}}'
    return 0
  fi
  private_dir APPLYDIR pkg-apply
  export TMPDIR=$APPLYDIR
  flag=$APPLYDIR/mismatch
  # Off for the pipeline, so both statuses can be read: under `pipefail`,
  # $? is the rightmost failure, which is not necessarily the build's.
  set +e +o pipefail
  NO_COLOR=1 NH_ELEVATION_STRATEGY="${NH_ELEVATION_STRATEGY:-pkexec}" \
    nixarchy-apply --yes --no-preview "${pins[@]}" </dev/null 2>&1 |
    awk -v flag="$flag" '/is not what you checked/ { print > flag }
         { gsub(/\033\[[0-9;?]*[A-Za-z]/, ""); gsub(/\033[()][A-Za-z0-9]/, "")
           sub(/.*\r/, ""); print; fflush() }'
  statuses=("${PIPESTATUS[@]}")
  set -e -o pipefail
  rc=${statuses[0]}; filt=${statuses[1]}

  local mismatch=false
  [ -s "$flag" ] && mismatch=true
  jq -nc --argjson rc "$rc" --argjson filt "$filt" --argjson mismatch "$mismatch" '
    {nixarchyPkgApply: {
      ok: ($rc == 0 and $filt == 0),
      exit: $rc,
      message: (if $filt != 0 then
                  "the log filter failed (exit \($filt)); nixarchy-apply exited \($rc)"
                elif $mismatch then "a file changed since you reviewed it -- nothing was copied or built; look at the queue again"
                elif $rc == 0 then "applied"
                else "nixarchy-apply exited \($rc)" end)}}'
}

# About a minute, and the panel says so before starting it. Worth doing:
# an index written before nixarchy #493 carries no unfree or broken flags
# at all, so every package on a stale index reads as free.
cmd_reindex() {
  need nixarchy-search
  # nixarchy-search builds the index, then opens its picker; with no
  # terminal the picker fails ("inappropriate ioctl for device") and the
  # script still exits 0. So its status says nothing, and the stamp is the
  # judge. stderr is kept for the reason when the index is still stale.
  local err facts opts
  err=$(NIXARCHY_IN_PICKER=1 nixarchy-search --reindex </dev/null 2>&1 >/dev/null 9>&- 8>&-) || :
  facts=$(index_facts)
  # The options come from the host's own flake. Reported beside the index,
  # never as the index failing.
  opts=$("$SELF" options refresh </dev/null 2>/dev/null) || opts=""
  jq -e . >/dev/null 2>&1 <<<"$opts" || opts='{"ok":false,"error":"options refresh gave no answer"}'
  if jq -e '.status == "fresh"' <<<"$facts" >/dev/null; then
    jq -nc --argjson index "$facts" --argjson options "$opts" \
      '{ok: true, indexStale: false, index: $index, options: $options, message: "index rebuilt"}'
    return 0
  fi
  err=$(tail -n 20 <<<"$err" | tail -c 65536)
  jq -nc --arg err "$err" --argjson index "$facts" --argjson options "$opts" \
    --arg log "$CACHE_DIR/index-errors.log" '
    ($err | split("\n")
          | map(sub("^\\s+"; "") | sub("\\s+$"; ""))
          | map(select(length > 0
              and (startswith("Building the search index.") | not)
              and (startswith("indexing nixpkgs (this takes") | not)
              and (startswith("no option index: documentation.nixos.enable is off") | not)
              and (. != "system, so there is no options.json to read.")
              and (. != "inappropriate ioctl for device")
              and (startswith("evaluation warning:") | not)))
          | .[-8:]) as $d
    | ([$d[] | select(startswith("indexing nixpkgs failed;") | not)] | last) as $why
    | {ok: false, indexStale: true, index: $index, options: $options, detail: $d,
       error: ("the search index is still \($index.status): "
               + ($why // "nixarchy-search gave no reason")
               + " -- see " + $log)}'
}

cmd_state() {
  local facts stale
  facts=$(index_facts)
  stale=$(jq -r '.status != "fresh"' <<<"$facts")
  options_resolve

  # Process substitution swallows a callee's exit status, so a read that
  # fails inside the jq below cannot be noticed there -- `$(cat <(f))` is 0
  # however f ended. Asked here instead, where the answer can still reach
  # the object. `-e` first: a file that is simply absent is the ordinary
  # first-run case, and an empty catalogue is the truth about it (#41).
  local unreadable=()
  [ -e "$APPS" ]     && [ ! -r "$APPS" ]     && unreadable+=("$APPS")     || :
  [ -e "$SERVICES" ] && [ ! -r "$SERVICES" ] && unreadable+=("$SERVICES") || :
  local unread_msg=""
  [ ${#unreadable[@]} -gt 0 ] && unread_msg="could not read ${unreadable[*]} -- it exists but is not readable, so what it holds is not shown here" || :
  local rpaths rrc=0 rfiles='[]'
  rpaths=$(interrupted) || rrc=$?
  if [ "$rrc" = 0 ]; then
    unread_msg=${unread_msg:+$unread_msg -- }$(recovery_message "$rpaths")
    rfiles=$(printf '%s' "$rpaths" | jq -Rsc 'split("\n") | map(select(length > 0))')
  fi

  local want=""
  if ! $stale; then
    want=$(extras_tsv | awk -F'\t' '$1 == "pkg" && $3 == "default" { print $2 }') || want=""
  fi

  jq -n \
    --rawfile apps <(rows_tsv "$APPS" app) \
    --rawfile services <(rows_tsv "$SERVICES" service) \
    --rawfile extras <(extras_tsv) \
    --rawfile labels <(labels_tsv "$want") \
    --argjson stale "$stale" \
    --argjson index "$facts" \
    --argjson options "$OPT_JSON" \
    --arg appsFile "$APPS" \
    --arg servicesFile "$SERVICES" \
    --arg unreadable "$unread_msg" \
    --argjson rfiles "$rfiles" \
    --arg channel "$(machine_channel)" \
    --arg flakeDir "${NIXARCHY_FLAKE:-/etc/nixos}" \
    --argjson flakeFound "$([ -r "${NIXARCHY_FLAKE:-/etc/nixos}/flake.nix" ] && echo true || echo false)" \
    --rawfile flakes <(cmd_flake_list) \
    "$UNTAG_JQ"'
    def lines: split("\n") | map(select(length > 0));
    def cols:  lines | map(split("\t"));

    ($labels | cols) as $lab |
    ($lab | map(select(.[0] == "app") | {key: .[1], value: .[2]}) | from_entries) as $label |
    ($lab | map(select(.[0] == "pkg")
        | ((.[3] // "") | split(" ") | map(select(length > 0))) as $f
        | { key: .[1], value: {
              summary: ((.[2] // "") | untag($f)),
              flags: $f,
              version: (if (.[4] // "") == "?" then "" else (.[4] // "") end) } })
      | from_entries) as $fact |

    {
      ok: true,
      indexStale: $stale,
      index: $index,
      # `options` below is the rows set in apps.nix, so where the option
      # list came from is optionsInfo.
      optionsInfo: $options,
      files: { apps: $appsFile, services: $servicesFile },
      channel: $channel,
      flakeDir: $flakeDir,
      flakeFound: $flakeFound,
      # Absent when every file read, so an ordinary state carries no
      # message. ok stays true: one unreadable file must not cost the user
      # the tabs that were fine, or the panel they would fix it from (#41).
    }
    + (if $unreadable == "" then {} else { message: $unreadable } end)
    + (if $rfiles == [] then {} else { recovery: { files: $rfiles } } end)
    + {
      # What this tool declared in the system flake. Read from the same
      # command a terminal calls, so the two cannot disagree.
      flakes: (($flakes | fromjson).inputs // []),
      flakesStale: (($flakes | fromjson).stale // false),
      apps: ($apps | cols | map({
        id: .[1], category: (.[2] // ""), enabled: (.[3] == "true"),
        line: (.[4] // ""), note: (.[5] // ""),
        label: ($label[.[1]] // .[1]),
        settings: (.[1] | test("\\.settings$"))
      })),
      services: ($services | cols | map({
        id: .[1], category: (.[2] // ""), enabled: (.[3] == "true"),
        line: (.[4] // ""), note: (.[5] // ""),
        label: ($label[.[1]] // .[1]),
        settings: (.[1] | test("\\.settings$"))
      })),
      packages: ($extras | cols | map(select(.[0] == "pkg") | {
        attr: .[1], channel: (.[2] // "default")
      } + (if .[2] == "default" and $fact[.[1]]
           then $fact[.[1]] | with_entries(select(.value != "")) else {} end))),
      options: ($extras | cols | map(select(.[0] == "opt") | {
        path: .[1], set: (.[2] == "true"), line: (.[3] // "")
      })),
      drafts: ($extras | cols | map(select(.[0] == "draft") | { name: .[1] }))
    }'
}

cmd_flake() {
  local action=${1-}; shift || true
  case "$action" in
    show)   cmd_flake_show "$@" ;;
    add)    cmd_flake_add "$@" ;;
    remove) cmd_flake_remove "$@" ;;
    update) cmd_flake_update "$@" ;;
    list)   cmd_flake_list "$@" ;;
    *) die "flake takes show, add, remove, update or list, not '${action:-nothing}'" ;;
  esac
}

main() {
  need jq
  local cmd=${1-}
  [ -n "$cmd" ] || die "usage: nixarchy-pkg <state|search|toggle|pkg|opt|draft|flake|recover|pending|check [--dry-run]|options refresh|apply|reindex>"
  shift
  case "$cmd" in
    state) cmd_state "$@" ;;
    search) cmd_search "$@" ;;
    toggle) cmd_toggle "$@" ;;
    pkg)    cmd_pkg "$@" ;;
    draft)  cmd_draft "$@" ;;
    opt)    cmd_opt "$@" ;;
    pending) cmd_pending "$@" ;;
    check)  cmd_check "$@" ;;
    options) cmd_options "$@" ;;
    apply)   cmd_apply "$@" ;;
    reindex) cmd_reindex "$@" ;;
    flake)   cmd_flake "$@" ;;
    recover) cmd_recover "$@" ;;
    *) die "no such command: $cmd" ;;
  esac
}

main "$@"
