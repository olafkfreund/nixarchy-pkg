#!/usr/bin/env bash
# nixarchy-pkg -- what the nixarchy.pkg panel needs to know, as JSON.
#
# The panel is QML inside the Omarchy shell and cannot run a package
# manager. This script is the whole of its contact with the machine: it
# reads the two selection files, searches the nixpkgs index, and calls the
# nixarchy writers that already know how to edit those files safely.
#
#   state                        the catalogue and what is selected
#   search <query> [--kind K] [--limit N]
#                                rows from the nixpkgs/options index
#   toggle app|service <id>      turn a catalogue row on or off
#   pkg add|remove <attr> [--stable|--unstable]
#                                a raw nixpkgs attribute
#   opt describe <path>          an option's type, default and example
#   opt set <path> <nix-value>   write a value for it
#   opt remove <path>            take it out again
#   draft new <url> | draft undraft <name>
#   pending                      what is queued but not yet applied
#   apply                        copy into the flake and rebuild
#   reindex                      rebuild the search index
#
# Every subcommand prints ONE object and exits 0, including on failure:
# a panel with `{"ok":false,"error":...}` can say what went wrong, where a
# panel with a non-zero exit and no output can only show an empty card.
#
# Nothing here reimplements a writer. Marker placement, catalogue drift,
# unfree policy, the pkgsOther channel escape, backups and the parse check
# all live in nixarchy-app-enable, nixarchy-service-enable,
# nixarchy-pkg-add, nixarchy-opt-remove and nixarchy-apply. A second
# implementation of any of them is a second set of bugs, and the #@opt
# line format is byte-exact -- nixarchy-opt-remove walks a comment block
# keyed on those bytes and nixarchy's checks.options asserts them.
#
# JSON is built with jq and never with printf: a package description or an
# option's documentation may contain a quote, a backslash or a newline,
# and the panel parses whatever this prints.

set -euo pipefail
umask 077

readonly CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nixarchy"
readonly CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/nixarchy"
readonly APPS="$CONFIG_DIR/apps.nix"
readonly SERVICES="$CONFIG_DIR/services.nix"
readonly INDEX="$CACHE_DIR/index.tsv"
readonly STAMP="$CACHE_DIR/stamp"

# Anything this prints is the panel's only account of what happened, so a
# failure is a value rather than an exit code.
die() {
  jq -nc --arg e "$1" '{ok: false, error: $e}'
  exit 0
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "$1 is not on PATH"
}

# The paths nixarchy-search bakes in at build time: options.json and the
# six others that key the index. Read out of the installed script rather
# than hardcoded, so they follow the system generation instead of going
# stale the first time nixpkgs moves. A missing one is not fatal -- the
# features that need it say so individually.
searched() {
  local var=$1 path
  path=$(command -v nixarchy-search 2>/dev/null) || return 0
  sed -n "s/^${var}=\\(.*\\)$/\\1/p" "$path" | head -1
}


# nixarchy's own staleness test, reproduced rather than guessed: the stamp
# holds what the index was built FROM, so an index built by an older
# nixarchy-search does not merely lag nixpkgs -- it can be missing whole
# fields. The unfree and broken flags arrived in #493, and an index from
# before it reports every package as free. The panel must be able to say
# so rather than quietly dropping the warning.
index_stale() {
  local key
  [ -s "$INDEX" ] || return 0
  key=$(printf '%s\n' \
    "$(searched nixpkgs)" "$(searched walk)" "$(searched optionsjson)" \
    "$(searched appindex)" "$(searched apptable)" \
    "$(searched flatpakrows)" "$(searched pkgnewrow)")
  [ "$(cat "$STAMP" 2>/dev/null)" != "$key" ]
}

# One selection file's marked rows, as TSV for jq to pick up.
#
# A row is a line carrying `#@ <id>`, under the most recent `── Name ──`
# header. It is on when the line's first non-space character is not a
# comment -- the same question nixarchy-service-enable asks, and a more
# honest one than grepping for `<id>.enable`, because it does not answer
# "yes" to `enable = false;`.
#
# The id is taken whole, so `#@ tailscale` and `#@ tailscale.settings` are
# two different rows and the settings row is reported separately rather
# than being mistaken for the service.
rows_tsv() {
  local file=$1 kind=$2
  [ -f "$file" ] || return 0
  awk -F'\t' -v kind="$kind" '
    # A section header, e.g. `  # \u2500\u2500 Network \u2500\u2500\u2500\u2500`. The rule is the
    # box-drawing character itself, so a comment that merely starts with a
    # word cannot be mistaken for one.
    /^[[:space:]]*#[[:space:]]*\xe2\x94\x80/ {
      line = $0
      gsub(/\xe2\x94\x80/, "", line)
      sub(/^[[:space:]]*#[[:space:]]*/, "", line)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
      if (line != "") category = line
      next
    }

    # A marked row.
    #
    # The marker alone is not enough to recognise one. These files explain
    # their own format in prose -- "the `#@ name` markers are how the menu
    # finds a line to uncomment" -- and that sentence is not a catalogue
    # row, though it carries the marker. What tells them apart is that a
    # row is a Nix assignment: it ends in a semicolon, and prose does not.
    /#@ [^ \t]+/ {
      if (match($0, /#@ [^ \t]+/) == 0) next
      id = substr($0, RSTART + 3, RLENGTH - 3)

      body = $0
      sub(/[[:space:]]*#@ .*$/, "", body)          # drop the marker onwards
      enabled = (body ~ /^[[:space:]]*[^#[:space:]]/) ? "true" : "false"
      sub(/^[[:space:]]*#[[:space:]]?/, "", body)  # uncomment for display
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", body)
      if (body !~ /=.*;$/) next

      note = $0
      sub(/^.*#@ [^ \t]+[[:space:]]*/, "", note)   # whatever trails the marker
      sub(/^#[[:space:]]*/, "", note)
      gsub(/\t/, " ", note)

      printf "%s\t%s\t%s\t%s\t%s\t%s\n", kind, id, category, enabled, body, note
    }
  ' "$file"
}

# The `#@pkg`, `#@opt` and `#@draft` lines, which are not catalogue rows:
# they are what the user added themselves. An option line is either a set
# value or a commented scaffold, and the panel needs to tell them apart.
extras_tsv() {
  [ -f "$APPS" ] || return 0
  awk '
    match($0, /#@pkg-other [^ \t]+/) {
      print "pkg\t" substr($0, RSTART + 12, RLENGTH - 12) "\tother"; next
    }
    match($0, /#@pkg [^ \t]+/) {
      print "pkg\t" substr($0, RSTART + 6, RLENGTH - 6) "\tdefault"; next
    }
    match($0, /#@opt [^ \t]+/) {
      path = substr($0, RSTART + 6, RLENGTH - 6)
      set = ($0 ~ /^[[:space:]]*#/) ? "false" : "true"
      body = $0
      sub(/[[:space:]]*#@opt .*$/, "", body)
      sub(/^[[:space:]]*#[[:space:]]?/, "", body)
      gsub(/\t/, " ", body)
      print "opt\t" path "\t" set "\t" body; next
    }
    match($0, /#@draft [^ \t]+/) {
      print "draft\t" substr($0, RSTART + 8, RLENGTH - 8) "\t"; next
    }
  ' "$APPS"
}

# Nicer labels for the app rows, when the index has them: field 3 of an
# `app` row reads "Brave (Browser)". Absent or stale index, the id stands
# on its own, which is what the selection file shows anyway.
labels_tsv() {
  [ -s "$INDEX" ] || return 0
  awk -F'\t' '$1 == "app" { print $2 "\t" $3 }' "$INDEX"
}

# The index, searched. 137k rows is too many to hand a QML list model, so
# ranking and the limit happen here and the panel receives only what it
# draws.
#
# Ranked by where the query landed, because a substring match over a
# corpus this size buries the obvious answer: searching "git" should not
# open on a package whose description merely mentions it. Exact name, then
# prefix, then anywhere in the name, then the summary.
#
# Field 4 is flags for a package (`unfree broken curated:firefox`) and the
# type for an option -- the same column meaning two things, which is why
# they are separated here rather than handed over raw.
cmd_search() {
  local query="" kind="" limit=50
  while [ $# -gt 0 ]; do
    case "$1" in
      --kind)  kind=${2-};  shift 2 ;;
      --limit) limit=${2-}; shift 2 ;;
      --kind=*)  kind=${1#*=};  shift ;;
      --limit=*) limit=${1#*=}; shift ;;
      -*) die "unknown flag: $1" ;;
      *) query=$1; shift ;;
    esac
  done

  [ -n "$query" ] || die "usage: nixarchy-pkg search <query> [--kind pkg|opt|app] [--limit N]"
  case "$limit" in ''|*[!0-9]*) die "--limit takes a number, not '$limit'" ;; esac
  case "$kind" in ''|pkg|opt|app) ;; *) die "--kind takes pkg, opt or app, not '$kind'" ;; esac
  [ -s "$INDEX" ] || die "no search index yet -- run: nixarchy-pkg reindex"

  local stale=false
  index_stale && stale=true

  jq -n \
    --rawfile rows <(
      awk -F'\t' -v OFS='\t' -v q="$query" -v want="$kind" -v lim="$limit" '
        BEGIN { lq = tolower(q) }
        want != "" && $1 != want { next }
        {
          name = tolower($2)
          if (name == lq)                    rank = 0
          else if (index(name, lq) == 1)     rank = 1
          else if (index(name, lq))          rank = 2
          else if (index(tolower($3), lq))   rank = 3
          else next
          # Shorter names first within a rank: "git" beats "gitAndTools.git-extras"
          print rank, length($2), $1, $2, $3, $4, $5
        }
      ' "$INDEX" | sort -t"$(printf '\t')" -k1,1n -k2,2n | head -n "$limit" | cut -f3-
    ) \
    --argjson stale "$stale" \
    --arg query "$query" \
    '
    def lines: split("\n") | map(select(length > 0));
    {
      ok: true,
      indexStale: $stale,
      query: $query,
      rows: ($rows | lines | map(split("\t")) | map({
        kind:    .[0],
        name:    .[1],
        summary: (.[2] // ""),
        # An option row carries its Nix type here; a package row carries
        # flags. Never both.
        type:    (if .[0] == "opt" then (.[3] // "") else "" end),
        flags:   (if .[0] == "opt" then []
                  else ((.[3] // "") | split(" ") | map(select(length > 0))) end),
        # Written into the row by the index builder with its newlines
        # escaped, because fzf re-runs a preview on every keystroke and
        # could not afford to look one up. Unescaped here; the panel draws
        # it as plain text.
        preview: ((.[4] // "") | gsub("\\\\n"; "\n"))
      }))
    }'
}

# Every write goes through a nixarchy writer, and the panel is told the new
# state rather than being trusted to predict it: the writers refuse things
# (an unfree package under a policy that forbids it, an id that drifted out
# of the catalogue), and a panel that assumed success would draw a lie.
#
# stderr is captured and returned, because it is where the writers explain
# a refusal. `|| rc=$?` around each call, because errexit is on and a
# refusal is an answer here, not a crash.
run_writer() {
  local out rc=0
  out=$("$@" 2>&1) || rc=$?
  WRITER_OUT=$out
  WRITER_RC=$rc
}

# The new state, plus what the writer said about getting there.
state_with() {
  local ok=$1 message=$2
  jq -n \
    --argjson state "$(cmd_state)" \
    --argjson ok "$ok" \
    --arg message "$message" \
    '$state + {ok: ($state.ok and $ok), message: $message}'
}

# The writer's exit code decides `ok`; the object is printed exactly once.
emit_state() {
  if [ "$WRITER_RC" = 0 ]; then
    state_with true "$WRITER_OUT"
  else
    state_with false "$WRITER_OUT"
  fi
}

cmd_toggle() {
  local kind=${1-} id=${2-}
  [ -n "$kind" ] && [ -n "$id" ] || die "usage: nixarchy-pkg toggle app|service <id>"
  case "$kind" in app|service) ;; *) die "toggle takes app or service, not '$kind'" ;; esac

  # Asked of the file rather than remembered, so two panels open at once
  # cannot disagree about which way the toggle goes.
  local file enabled verb
  case "$kind" in
    app)     file=$APPS ;;
    service) file=$SERVICES ;;
  esac
  [ -f "$file" ] || die "no $file -- log in again to have it created"

  if grep -qE "^[[:space:]]*[^#[:space:]].*#@ ${id//./\\.}([[:space:]]|\$)" "$file"; then
    enabled=true
  elif grep -qE "#@ ${id//./\\.}([[:space:]]|\$)" "$file"; then
    enabled=false
  else
    die "no $kind '$id' in $file"
  fi

  if [ "$enabled" = true ]; then verb=disable; else verb=enable; fi
  need "nixarchy-$kind-$verb"
  run_writer "nixarchy-$kind-$verb" "$id"
  emit_state
}

cmd_pkg() {
  local action=${1-}; shift || true
  case "$action" in
    add)
      local channel=() attrs=()
      while [ $# -gt 0 ]; do
        case "$1" in
          --stable|--unstable) channel=("$1"); shift ;;
          -*) die "unknown flag: $1" ;;
          *) attrs+=("$1"); shift ;;
        esac
      done
      [ ${#attrs[@]} -gt 0 ] || die "usage: nixarchy-pkg pkg add <attr> [--stable|--unstable]"
      need nixarchy-pkg-add
      run_writer nixarchy-pkg-add "${channel[@]}" "${attrs[@]}"
      ;;
    remove)
      [ $# -gt 0 ] || die "usage: nixarchy-pkg pkg remove <attr>"
      need nixarchy-pkg-remove
      run_writer nixarchy-pkg-remove "$@"
      ;;
    *) die "pkg takes add or remove, not '${action:-nothing}'" ;;
  esac
  emit_state
}

cmd_draft() {
  local action=${1-}; shift || true
  case "$action" in
    new)
      [ $# -gt 0 ] || die "usage: nixarchy-pkg draft new <url>"
      need nixarchy-pkg-new
      run_writer nixarchy-pkg-new "$@"
      ;;
    undraft)
      [ $# -gt 0 ] || die "usage: nixarchy-pkg draft undraft <name>"
      need nixarchy-pkg-undraft
      run_writer nixarchy-pkg-undraft "$@"
      ;;
    *) die "draft takes new or undraft, not '${action:-nothing}'" ;;
  esac
  emit_state
}

# An option's declared type, documentation, default and example, straight
# out of options.json.
#
# `default` and `example` are rendered `{_type: literalExpression, text:
# ...}` in a modern options.json and a bare JSON value in an older one, so
# both shapes are handled. They are read structurally here and never
# re-parsed out of the index's preview text, which flattened them for
# display.
#
# `widget` is this script's answer to "what can the panel draw for this?".
# The patterns are the ones nixarchy-search's own option picker uses, and
# they are anchored exactly as it anchors them: `list of string` and `null
# or path` deliberately fall through to the scaffold, because their value
# is not one prompted word and a form that pretended otherwise would write
# plausible-looking wrong configuration.
cmd_opt_describe() {
  local path=${1-}
  [ -n "$path" ] || die "usage: nixarchy-pkg opt describe <path>"
  local oj; oj=$(searched optionsjson)
  [ -n "$oj" ] && [ -f "$oj" ] || die "no options.json on this system -- it builds no manual"

  # What apps.nix already says about it, so the form can open on the value
  # that is there rather than on the default (#28). Found by the writers'
  # own rule -- the marker at the END of the line, compared as a string,
  # never a pattern -- and reported as the local expression, verbatim:
  # `lib.mkDefault true` is text here, not a boolean.
  local found="" cstate=absent cvalue=""
  if [ -f "$APPS" ]; then
    found=$(NIXARCHY_PKG_PATH="$path" awk '
      BEGIN { p = ENVIRON["NIXARCHY_PKG_PATH"]; m = "#@opt " p }
      length($0) >= length(m) && substr($0, length($0) - length(m) + 1) == m {
        line = $0; sub(/^[ \t]*/, "", line)
        if (line == "# " p " = ;  " m) { print "scaffold"; exit }
        pre = p " = "; post = ";  " m
        if (substr(line, 1, length(pre)) == pre &&
            substr(line, length(line) - length(post) + 1) == post) {
          print "set"
          print substr(line, length(pre) + 1, length(line) - length(pre) - length(post))
          exit
        }
        # Marked, but not in either written form: somebody edited it by
        # hand. It is set; its value is everything before the marker.
        sub(/[ \t]*#@opt .*$/, "", line)
        print "set"; print line; exit
      }' "$APPS")
  fi
  if [ -n "$found" ]; then
    cstate=${found%%$'\n'*}
    [[ $found == *$'\n'* ]] && cvalue=${found#*$'\n'}
  fi

  jq --arg p "$path" --arg cstate "$cstate" --arg cvalue "$cvalue" '
    def literal: if type == "object" then (.text // tostring) else tojson end;
    # One enum alternative this form can offer and write back verbatim: a
    # quoted string (escapes allowed) or an integer. Non-capturing, because
    # scan() returns the groups instead of the match when there are any.
    def alt: "\"(?:[^\"\\\\]|\\\\.)*\"|-?[0-9]+";
    .[$p] as $o
    | if $o == null then {ok: false, error: ("no such option: " + $p)}
      else
        ($o.type // "") as $t
        # All the alternatives or none: `one of 6, 7, 8` used to yield an
        # empty dropdown and `one of "foo", 7` half of one (#28). A type
        # whose list is prose, or mixes in anything else, is written as
        # Nix in the scaffold instead.
        | ($t | test("^one of (?:" + alt + ")(?:, (?:" + alt + "))*$")) as $listed
        | {
            ok: true,
            path: $p,
            type: $t,
            description: ($o.description // ""),
            readOnly: ($o.readOnly // false),
            declarations: ($o.declarations // []),
            default: (if $o.default == null then "" else ($o.default | literal) end),
            example: (if $o.example == null then "" else ($o.example | literal) end),
            widget:
              if   $t == "boolean" then "boolean"
              elif $listed then "enum"
              elif ($t | test("^(signed integer|unsigned integer|positive integer)")
                    or ($t | test("^[0-9]+ bit unsigned integer"))) then "integer"
              elif ($t | test("^(string|path|absolute path)([,[:space:]]|$)")) then "string"
              else "scaffold" end,
            # For an enum, the alternatives as the panel should offer them,
            # quotes included: they are written into the file verbatim.
            choices:
              (if $listed then [ $t | ltrimstr("one of ") | scan(alt) ] else [] end),
            choicesUnavailable: (($t | startswith("one of ")) and ($listed | not)),
            current:
              (if $cstate == "set" then {state: "set", value: $cvalue}
               elif $cstate == "scaffold" then {state: "scaffold"}
               else {state: "absent"} end)
          }
      end' "$oj"
}

# One physical line, whatever the editor allowed.
#
# nixarchy-opt-remove deletes the single line carrying the marker. A value
# written across several lines leaves the earlier ones orphaned, so the
# removal makes the file unparseable, its guard reverts, and the option can
# never be taken out again except by hand. The multiline editor exists
# because an example like services.postgresql.package's default is nine
# lines, so newlines become spaces: Nix does not care about them, and the
# remover does.
#
# Nothing else changes. This used to squeeze every run of spaces too, which
# rewrote "a  b" as "a b" -- a value that parses and is not the one asked
# for (#28). And where a newline DOES mean something -- inside a '' string,
# or ending a # comment that would otherwise swallow the rest of the line --
# the value is refused rather than quietly changed. A raw newline inside a
# "..." string still becomes a space; telling that apart needs a Nix lexer.
#
# Returns 1 instead of dying: it runs inside $(...), where die's object
# would become the value.
readonly FLAT_REFUSAL="a multi-line value with '' or # cannot be written on one line without changing its meaning -- put it on one line yourself. Nothing was changed."
flat_value() {
  local v=$1
  if [[ $v == *$'\n'* ]] && [[ $v == *"''"* || $v == *'#'* ]]; then
    return 1
  fi
  printf '%s' "${v//$'\n'/ }"
}

# Write a value for an option.
#
# The line is byte-exact and that is not style: nixarchy-opt-remove walks
# the comment block above a scaffold keyed on `# <path> = ;  #@opt <path>`,
# and nixarchy's checks.options asserts both forms, seed included. A near
# miss here is a line nothing can ever remove again.
#
#   <path> = <value>;  #@opt <path>       a set value
#   # <path> = ;  #@opt <path>            a scaffold's marked line
#
# It goes into apps.nix, where nixarchy-search puts option lines and where
# nixarchy-opt-remove looks for them -- not advanced.nix, which would be a
# line no remover could find.
#
# An empty value writes NOTHING and says so. A copied-out default is a line
# that reads as a choice and is not one.
cmd_opt_set() {
  local path=${1-} value=${2-}
  [ -n "$path" ] || die "usage: nixarchy-pkg opt set <path> <nix-value>"
  [ -f "$APPS" ] || die "no $APPS -- log in again to have it created"

  case "$path" in
    *[!a-zA-Z0-9._-]* | "" ) die "'$path' is not an option path" ;;
  esac

  if grep -q "#@opt ${path//./\\.}\$" "$APPS"; then
    die "$path is already in $APPS -- remove it first"
  fi

  value=$(flat_value "$value") || die "$FLAT_REFUSAL"

  if [ -z "${value//[[:space:]]/}" ]; then
    state_with true "kept the default for $path -- nothing written"
    return 0
  fi

  local backup; backup=$(mktemp)
  cp "$APPS" "$backup"
  # shellcheck disable=SC2064  # $backup is fixed at trap time, deliberately
  trap "rm -f '$backup'" RETURN

  local tmp; tmp=$(mktemp)
  # Through the environment, not `awk -v`: -v processes escape sequences in
  # the value it is given, so a Nix string containing a backslash would
  # arrive mangled. ENVIRON does no such processing. The newlines are
  # printf's inside awk for the same reason -- a $(...) payload would have
  # its trailing newline stripped, and the line would land on the closing
  # brace.
  #
  # Inserted before the module's closing brace, which is where
  # nixarchy-search puts its own option lines.
  NIXARCHY_PKG_PATH="$path" NIXARCHY_PKG_VALUE="$value" awk '
    !ins && /^}[[:space:]]*$/ {
      printf "\n  %s = %s;  #@opt %s\n",
        ENVIRON["NIXARCHY_PKG_PATH"], ENVIRON["NIXARCHY_PKG_VALUE"],
        ENVIRON["NIXARCHY_PKG_PATH"]
      ins = 1
    }
    { print }
  ' "$APPS" > "$tmp"
  mv "$tmp" "$APPS"

  # Nix's own words, not a guess at them. `--parse` also resolves names, so
  # the commonest failure here is not a syntax error at all: a value that
  # says `pkgs.foo` in a file whose header is `{ ... }:` fails with
  # "undefined variable 'pkgs'", and "that would have left the file
  # unparseable" sends the reader looking for a typo that is not there.
  local why
  if ! why=$(nix-instantiate --parse "$APPS" 2>&1 >/dev/null); then
    cp "$backup" "$APPS"
    # One awk rather than `grep … | head -1`: grep exits 1 when nothing
    # matches, and under `pipefail` that killed this function before the
    # die() below could report anything -- the fallback on the next line
    # has never once been reached. `head` closing the pipe could also take
    # grep out with SIGPIPE on a long error, failing a match that DID
    # happen. awk exits 0 either way, and a here-string leaves no pipeline
    # to have a status at all.
    why=$(awk '/^error:/ { print; exit }' <<<"$why")
    die "that value was refused, so nothing was changed. ${why:-nix could not parse the result}"
  fi

  state_with true "set $path = $value"
}

# Change an option that is already set, in one command that either changes
# it or leaves the file exactly as it was.
#
# `opt set` refuses a path that is already present ("remove it first"), so
# changing a value has meant `opt remove` then `opt set` -- two invocations
# with two backups and nothing covering the pair. A set that fails after a
# successful remove loses the option outright, when what was asked for was a
# change. The difference here is one backup, taken before anything is
# touched.
#
# A sibling rather than a --force on `opt set`, deliberately: that refusal
# is a useful guard against a caller clobbering a line somebody wrote by
# hand, and keeping a separate verb keeps the guard.
cmd_opt_replace() {
  local path=${1-} value=${2-}
  [ -n "$path" ] && [ $# -ge 2 ] ||
    die "usage: nixarchy-pkg opt replace <path> <nix-value>"
  [ -f "$APPS" ] || die "no $APPS -- log in again to have it created"

  case "$path" in
    *[!a-zA-Z0-9._-]* | "" ) die "'$path' is not an option path" ;;
  esac

  grep -q "#@opt ${path//./\\.}\$" "$APPS" ||
    die "$path is not in $APPS -- use 'opt set' to add it"

  value=$(flat_value "$value") || die "$FLAT_REFUSAL"

  # BEFORE anything is touched. This is the whole point of the command.
  local backup; backup=$(mktemp)
  cp "$APPS" "$backup"
  # shellcheck disable=SC2064  # $backup is fixed at trap time, deliberately
  trap "rm -f '$backup'" RETURN

  # Keyed on the marker rather than on position: the line is wherever the
  # person moved it to, and the marker is what finds it. Through the
  # environment rather than `awk -v` for the reason cmd_opt_set gives -- -v
  # processes escape sequences, so a Nix value containing a backslash would
  # arrive mangled.
  local tmp; tmp=$(mktemp)
  NIXARCHY_PKG_PATH="$path" NIXARCHY_PKG_VALUE="$value" awk '
    {
      marker = "#@opt " ENVIRON["NIXARCHY_PKG_PATH"]
      if (!done && index($0, marker) > 0 &&
          substr($0, length($0) - length(marker) + 1) == marker) {
        printf "  %s = %s;  %s\n",
          ENVIRON["NIXARCHY_PKG_PATH"], ENVIRON["NIXARCHY_PKG_VALUE"], marker
        done = 1
        next
      }
      print
    }
  ' "$APPS" > "$tmp"
  mv "$tmp" "$APPS"

  if ! grep -q "#@opt ${path//./\\.}\$" "$APPS"; then
    cp "$backup" "$APPS"
    die "could not find $path to replace after all. Nothing was changed."
  fi

  local why
  if ! why=$(nix-instantiate --parse "$APPS" 2>&1 >/dev/null); then
    cp "$backup" "$APPS"
    # One awk rather than `grep … | head -1`: grep exits 1 when nothing
    # matches, and under `pipefail` that killed this function before the
    # die() below could report anything -- the fallback on the next line
    # has never once been reached. `head` closing the pipe could also take
    # grep out with SIGPIPE on a long error, failing a match that DID
    # happen. awk exits 0 either way, and a here-string leaves no pipeline
    # to have a status at all.
    why=$(awk '/^error:/ { print; exit }' <<<"$why")
    die "that value was refused, so nothing was changed. ${why:-nix could not parse the result}"
  fi

  state_with true "replaced $path = $value"
}

cmd_opt() {
  local action=${1-}; shift || true
  case "$action" in
    describe) cmd_opt_describe "$@" ;;
    set)      cmd_opt_set "$@" ;;
    replace)  cmd_opt_replace "$@" ;;
    remove)
      [ $# -gt 0 ] || die "usage: nixarchy-pkg opt remove <path>"
      need nixarchy-opt-remove
      run_writer nixarchy-opt-remove "$@"
      emit_state
      ;;
    *) die "opt takes describe, set, replace or remove, not '${action:-nothing}'" ;;
  esac
}

# ---- the system flake -------------------------------------------------
#
# The one place this project writes outside its own selection files, and
# the reason the writes here are appended rather than edited.
#
# `{ a = { x = 1; }; a.y = 2; }` evaluates to `{ a = { x = 1; y = 2; }; }`:
# a path assignment merges with an attrset that already exists. So an
# input is declared by appending ONE top-level line and letting Nix merge
# it, rather than by finding the `inputs { }` block and inserting into it
# -- which would mean matching braces in somebody else's Nix and rewriting
# a region they own and formatted.

# The line the flake's outer attrset opens on. Verified rather than
# assumed: a flake whose outer brace is not a bare `{` at column 0 is
# declined, because appending to the wrong scope would produce a file that
# parses and means something else.
flake_anchor() {
  local file=$1 n
  # One awk rather than `grep -n | head -1 | cut`: `|| true` kept the
  # no-match case alive but swallowed a grep that failed for a real reason,
  # and a SIGPIPE from head closing the pipe would lose a match that did
  # happen -- and an empty answer here means the flake is DECLINED, so a
  # lost match declines a flake that was fine.
  n=$(awk '/^\{$/ { print NR; exit }' "$file")
  [ -n "$n" ] || return 1
  printf '%s' "$n"
}

# Two lists, both read, neither hard-coded.
#
# The flake's own input names are a hard constraint: declaring one twice
# is an error, so a collision is refused.
#
# nixarchy's are a warning, not a refusal, and the difference is measured.
# The installer template hands modules `self.inputs // nixarchy.inputs`,
# and `//` is right-biased, so there a colliding name locks fine and is
# then silently ignored. A flake that adopted nixarchy as one input among
# many typically passes its own `inputs` straight through and shadows
# nothing. Refusing everyone to protect the first group would block
# legitimate names for the larger second one.
#
# Read, because a hand-kept list was wrong before it was used: it had
# twelve names where the lock says seventeen, and the five it missed
# included `nixpkgs`.
flake_names() {
  local lock="${NIXARCHY_FLAKE:-/etc/nixos}/flake.lock"
  [ -r "$lock" ] || return 0
  case "${1-}" in
    own)      jq -r '.nodes[.root].inputs | keys[]' "$lock" 2>/dev/null || true ;;
    nixarchy) jq -r '
        (.nodes[.root].inputs.nixarchy // empty) as $n
        | if ($n | type) == "string"
          then (.nodes[$n].inputs // {} | keys[])
          else empty end
      ' "$lock" 2>/dev/null || true ;;
  esac
  return 0
}

# The useful line out of a nix error, which is not the first one.
#
# Modern nix prints a bare `error:` and then indents the detail under it,
# so the anchored `^error:` that works for nix-instantiate --parse yields
# the prefix and nothing else. Take the first line that carries `error:`
# AND says something after it; fall back to the first non-empty line, so
# an unfamiliar format degrades to nix's words rather than to ours.
nix_why() {
  local file=$1 why
  # Matching nothing is a legitimate answer here, and under
  # `set -euo pipefail` an empty match would otherwise take the whole script
  # down in the middle of a write, with no message at all. This used to say
  # `|| true` on each pipeline, which survived that but equally survived a
  # grep that failed for a real reason, and could still lose a match to
  # SIGPIPE when head closed the pipe on a long log. One awk per branch
  # exits 0 whether or not it matched, and leaves no pipeline to guard.
  why=$(awk '/error:/ {
               sub(/^[[:space:]]*/, ""); sub(/^error:[[:space:]]*/, "")
               if ($0 != "") { print; exit }
             }' "$file")
  [ -n "$why" ] || why=$(awk 'NF { sub(/^[[:space:]]*/, ""); print; exit }' "$file")
  printf '%s' "$why"
}

# What a flake offers, before anything is written. `nix flake show`
# needs no build -- measured at 1.4s on a local flake and 10s for a first
# remote fetch.
#
# It enumerates less than it looks like it does, and the gap is the whole
# reason this reports three lists instead of one. Measured identically on
# nixvim, home-manager and sops-nix:
#
#   nixosModules        {"default": {"type":"nixos-module"}, "<name>": ...}
#   homeManagerModules  {"type": "unknown"}
#
# `nixosModules` is typed and enumerable. Every other module namespace is
# a community convention rather than schema, and comes back as one opaque
# leaf. Those are reported as unreadable BY NAME: an empty list would read
# as "this flake offers none", which is a different and false statement.
#
# A timeout, because a flake using import-from-derivation can make even
# `show` build. Bounded and reported, rather than left hanging.
cmd_flake_show() {
  local ref=${1-} out rc=0
  [ -n "$ref" ] || die "usage: nixarchy-pkg flake show <flakeref>"
  need nix
  # Streams kept apart, unlike run_writer, which merges them deliberately
  # because a writer's output IS prose. This one is a data channel: nix
  # prints progress and warnings on stderr, and folding those into stdout
  # puts banner text in front of the JSON and breaks the parse.
  local err; err=$(mktemp)
  # shellcheck disable=SC2064  # $err is fixed at trap time, deliberately
  trap "rm -f '$err'" RETURN
  out=$(timeout 120 nix flake show --json "$ref" 2>"$err") || rc=$?
  if [ "$rc" != 0 ]; then
    local why; why=$(nix_why "$err")
    jq -nc --arg ref "$ref" --arg why "${why:-could not inspect $ref}" \
      '{ok: false, ref: $ref, message: $why}'
    return 0
  fi
  # An enumerable namespace is an object of attributes; an opaque one is a
  # single leaf carrying "type". `has("type")` is the whole difference.
  printf '%s' "$out" | jq -c --arg ref "$ref" '
    . as $f
    | {
      ok: true,
      ref: $ref,
      nixosModules:
        (($f.nixosModules // {}) | if has("type") then [] else keys end),
      packages:
        (($f.packages // {}) | to_entries | map(.value | keys) | add // [] | unique),
      opaque:
        ([ "homeManagerModules", "homeManagerModule", "homeModules",
           "darwinModules", "nixDarwinModules", "flakeModules", "modules" ]
         | map(select($f[.] != null
                      and ($f[.] | type) == "object"
                      and ($f[.] | has("type")))))
    }' 2>/dev/null || {
      jq -nc --arg ref "$ref" '{ok: false, ref: $ref, message: "could not read what that flake exposes"}'
    }
}

# Declare an input. The riskiest write this project makes -- the system
# flake, where a bad line fails the whole machine's evaluation rather than
# one package -- so it follows cmd_opt_set's discipline below (backup,
# write, validate, restore, report nix's own words) with one step added
# for the lock and one taken BEFORE the write.
#
# The baseline matters more than it looks. Checking only afterwards means
# a flake that was already broken gets blamed on whatever was added last,
# which is this. So the question asked is a delta -- did THIS change it --
# not an absolute.
#
# What is deliberately NOT checked is whether a host still builds.
# Evaluating one costs minutes and proves far more than is at stake: an
# input nothing imports cannot break a host. Parse, resolve, lock.
cmd_flake_add() {
  local name=${1-} ref=${2-}
  [ -n "$name" ] && [ -n "$ref" ] || die "usage: nixarchy-pkg flake add <name> <flakeref>"
  case "$name" in
    [A-Za-z_]*) ;;
    *) die "'$name' is not a usable input name -- it has to start with a letter or underscore" ;;
  esac
  need nix

  local dir="${NIXARCHY_FLAKE:-/etc/nixos}" file lock
  file="$dir/flake.nix"; lock="$dir/flake.lock"
  [ -w "$file" ] || die "cannot write $file"

  local at; at=$(flake_anchor "$file") ||
    die "cannot find where $file opens -- its outer { is not on a line of its own, so I do not know where a top-level line would go. Add the input by hand."

  if grep -qE "#@flake-input ${name}\$" "$file"; then
    die "'$name' is already declared here by this tool"
  fi
  if flake_names own | grep -qxF "$name"; then
    die "'$name' is already an input of this flake. Two definitions of one input is an error, so nothing was changed."
  fi

  # A warning, not a refusal. See flake_names.
  local warn=""
  if flake_names nixarchy | grep -qxF "$name"; then
    warn="nixarchy also has an input called '$name'. If this flake hands its modules nixarchy's inputs merged over its own -- the installer's template does -- yours will be locked and then silently ignored. If it passes its own inputs straight through, this is fine."
  fi

  local err; err=$(mktemp)
  local bnix; bnix=$(mktemp)
  local block; block=$(mktemp)
  # shellcheck disable=SC2064  # fixed at trap time, deliberately
  trap "rm -f '$err' '$bnix' '$block'" RETURN

  if ! nix flake metadata "$dir" >/dev/null 2>"$err"; then
    die "this flake does not evaluate as it stands, so I have changed nothing rather than add to a broken file: $(nix_why "$err")"
  fi

  cp "$file" "$bnix"
  # `|| :` because a bare `[ -f ] && cp` that tests false returns 1, which
  # under errexit ends the command here rather than skipping a copy.
  [ -f "$lock" ] && cp "$lock" "$block" || :
  restore_flake() {
    cp "$bnix" "$file"
    [ -s "$block" ] && cp "$block" "$lock" || :
  }

  # After the outer brace, so it lands at the top level of the flake's own
  # attrset. Nix merges it with whatever `inputs = { ... }` is already
  # there, which is why the existing block is never touched.
  local line="  inputs.${name}.url = \"${ref}\";  #@flake-input ${name}"
  local tmp; tmp=$(mktemp)
  awk -v at="$at" -v line="$line" 'NR == at { print; print line; next } { print }' \
    "$file" > "$tmp" && mv "$tmp" "$file"

  if ! nix-instantiate --parse "$file" >/dev/null 2>"$err"; then
    restore_flake
    die "that would have left $file unparseable, so nothing was changed: $(nix_why "$err")"
  fi

  if ! nix flake lock "$dir" >/dev/null 2>"$err"; then
    restore_flake
    die "could not lock '$ref', so nothing was changed: $(nix_why "$err")"
  fi

  if ! nix flake metadata "$dir" >/dev/null 2>"$err"; then
    restore_flake
    die "the flake stopped evaluating with '$name' in it, so nothing was changed: $(nix_why "$err")"
  fi

  # The import line is SHOWN, never written. `default` is the answer the
  # flake itself gives to "which module" -- measured convention across
  # nixvim, home-manager and sops-nix, all of which expose `default`
  # beside a named alias. Every other choice is still open: which host,
  # whether the module takes arguments, whether an option must be set to
  # enable it. Knowing the attribute settles one of four, which is not
  # permission to edit a file this tool does not own.
  jq -nc --arg name "$name" --arg ref "$ref" --arg warn "$warn" \
    '{ok: true, name: $name, url: $ref,
      message: (("declared " + $name + " and locked it")
                + (if $warn == "" then "" else " -- " + $warn end)),
      import: ("inputs." + $name + ".nixosModules.default"),
      importNote: "Add that to the imports of the host that should have it. This tool does not know which file that is."}'
}

# Removal refuses rather than succeeds-and-breaks. Taking out a
# declaration something else depends on fails evaluation, which is the one
# thing this must never do quietly.
cmd_flake_remove() {
  local name=${1-}
  [ -n "$name" ] || die "usage: nixarchy-pkg flake remove <name>"
  need nix

  local dir="${NIXARCHY_FLAKE:-/etc/nixos}" file lock
  file="$dir/flake.nix"; lock="$dir/flake.lock"
  grep -qE "#@flake-input ${name}\$" "$file" ||
    die "no input '$name' declared here by this tool. Nothing was changed."

  # Anything else in the flake that names it -- an import somebody pasted,
  # a specialArgs reference -- other than the declaration itself.
  # One awk rather than two greps into head: `|| true` survived no-match,
  # which is the common case, but equally survived a grep that failed for a
  # real reason -- and an empty answer here means "nothing else refers to
  # it, go ahead and remove it", so a lost match removes a declaration that
  # something still uses.
  local used
  used=$(awk -v n="$name" '
    $0 ~ "\\<" n "\\>" && $0 !~ "#@flake-input " n "$" { print NR ":" $0; exit }' "$file")
  if [ -n "$used" ]; then
    die "'$name' is still referred to at $file:${used%%:*}, so removing its declaration would break evaluation. Take that reference out first."
  fi

  if [ -r "$lock" ]; then
    local follower
    # Two shapes, and missing the second is how this check quietly does
    # nothing: a direct dependency is stored as the node name, a string,
    # while a `follows` is stored as a PATH -- ["mine"] -- so comparing
    # against the string alone never matches the case this exists for.
    follower=$(jq -r --arg n "$name" '
      .nodes | to_entries
      | map(select(.value.inputs? // {} | to_entries
                   | any(.value == $n
                         or ((.value | type) == "array" and .value[0] == $n))))
      | map(.key) | map(select(. != "root")) | first // empty' "$lock" 2>/dev/null || true)
    if [ -n "$follower" ]; then
      die "'$follower' follows '$name' in flake.lock, so removing it would break evaluation. Nothing was changed."
    fi
  fi

  local err bnix block
  err=$(mktemp); bnix=$(mktemp); block=$(mktemp)
  # shellcheck disable=SC2064  # fixed at trap time, deliberately
  trap "rm -f '$err' '$bnix' '$block'" RETURN
  cp "$file" "$bnix"
  [ -f "$lock" ] && cp "$lock" "$block" || :

  sed -i -E "/#@flake-input ${name}\$/d" "$file"

  if ! nix-instantiate --parse "$file" >/dev/null 2>"$err"; then
    cp "$bnix" "$file"
    die "that would have left $file unparseable, so nothing was changed: $(nix_why "$err")"
  fi
  if ! nix flake metadata "$dir" >/dev/null 2>"$err"; then
    cp "$bnix" "$file"
    [ -s "$block" ] && cp "$block" "$lock" || :
    die "the flake stopped evaluating without '$name', so nothing was changed: $(nix_why "$err")"
  fi

  # The lock entry is left. `nix flake lock` does not prune, the entry is
  # inert, and a second write for tidiness is a second chance to break
  # something.
  jq -nc --arg name "$name" '{ok: true, name: $name, message: ("removed " + $name)}'
}

# What this tool declared, so a terminal and the panel see one answer.
cmd_flake_list() {
  local file="${NIXARCHY_FLAKE:-/etc/nixos}/flake.nix"
  [ -r "$file" ] || { jq -nc '{ok: true, inputs: []}'; return 0; }
  { grep -oE '^[[:space:]]*inputs\.[A-Za-z_][A-Za-z0-9_-]*\.url[[:space:]]*=[[:space:]]*"[^"]+";[[:space:]]*#@flake-input [A-Za-z_][A-Za-z0-9_-]*$' "$file" || true; } |
    sed -E 's/^[[:space:]]*inputs\.([^.]+)\.url[[:space:]]*=[[:space:]]*"([^"]+)".*/\1\t\2/' |
    jq -Rsc '{ok: true, inputs: (split("\n") | map(select(length > 0)) | map(split("\t") | {name: .[0], url: .[1]}))}'
}

# Where nixarchy-apply copies the selection to. A flake cannot read a file
# outside its own tree, which is why the copy exists at all; comparing the
# two is therefore the honest answer to "what would apply change?", rather
# than anything this script remembers.
flake_base() {
  local flake base
  flake=${NIXARCHY_FLAKE:-/etc/nixos}
  base=$flake
  [ -d "$flake/hosts/$(uname -n)" ] && base="$flake/hosts/$(uname -n)"
  printf '%s' "$base"
}

# Which channel this machine follows, so the panel can name the OTHER one
# and not offer a request the writer would refuse.
#
# Copied from nixarchy-pkg-add:80-88 rather than asked of
# `nixarchy-channel`, deliberately. The question is not "what is true"
# but "what will the writer that acts on this request decide", and only
# the writer's own parse answers that -- nixarchy-channel is a different
# program, and reports in prose (its :92) with no machine-readable mode.
# A copy pinned to a cited line cannot disagree with it; asking a second
# opinion can.
#
# Read from the URL, which is what an update resolves, not the lock,
# which is only where it last landed. `custom` is a real answer: the
# flat `inputs.nixpkgs.url` form and a reshaped flake both land there,
# and the panel says so rather than guessing.
machine_channel() {
  local flakedir u
  flakedir="${NIXARCHY_FLAKE:-/etc/nixos}"
  [ -r "$flakedir/flake.nix" ] || { printf custom; return; }
  u=$(sed -nE "s/^[[:space:]]*nixpkgs\.url[[:space:]]*=[[:space:]]*\"([^\"]+)\".*/\1/p" \
    "$flakedir/flake.nix" | head -1)
  case "$u" in
    *nixos-unstable*) printf unstable ;;
    *nixos-[0-9][0-9].[0-9][0-9]*) printf stable ;;
    *) printf custom ;;
  esac
}

# Queued changes: marked lines that differ between the selection and the
# copy the flake last saw.
#
# A machine that has never applied has no copy at all. That is not an
# error and not "nothing queued" -- it is everything currently selected,
# and the panel is told which of the two it is looking at.
# A file's LIVE marked lines, indentation and block scaffolding removed.
#
# Live only, and that is the whole point: a row that is commented out on
# both sides is not a queued change, however much its text moved. Topping
# a catalogue up with nixarchy-catalogue-diff --add appends sixteen
# commented rows, and counting those told the user sixteen things were
# waiting to be built when nothing was.
#
# The #@pkgs-begin / #@pkgs-end wrappers are scaffolding pkg-add creates
# on first use rather than choices anyone made, so they go too --
# otherwise picking one package reports three changes.
marked() {
  grep -E '^[[:space:]]*[^#[:space:]].*#@' "$1" 2>/dev/null |
    grep -vE '#@pkgs-(begin|end)' | sed 's/^[[:space:]]*//' || true
}


# The marked lines that differ, one per line, as `sign<TAB>part<TAB>line`.
#
# A function called in the main shell rather than a <(…) inside the jq call,
# because nothing inside a process substitution can stop the command reading
# it: the subshell exits, its end of the pipe closes, and jq carries on and
# prints a confident answer built from however much arrived. Every failure
# below has to be one this can RETURN, so cmd_pending can act on it.
pending_changes() {
  local base=$1 part src dst out rc
  for part in apps services advanced; do
    src="$CONFIG_DIR/$part.nix"
    dst="$base/nixarchy/$part.nix"
    [ -f "$src" ] || continue
    # A file that exists and cannot be read is not an empty one. marked()
    # sends its errors to /dev/null and returns nothing, so an unreadable
    # selection file used to report every live line in the applied copy as
    # REMOVED -- a confident list of changes nobody made.
    [ -r "$src" ] || return 2
    # A machine that has never applied has no copy, which is the same
    # question asked against an empty one.
    #
    # `diff` is run on its own rather than piped, because its three exit
    # codes mean three different things and only one is a failure: 0 no
    # differences, 1 differences, 2 or more it could not do the job. Piped
    # under `pipefail` the 1 took the whole loop down on the FIRST file that
    # had a change, so apps was reported and services and advanced were
    # dropped -- the count the panel's footer draws, wrong by every change
    # after the first. `|| true` would have fixed that by making an
    # unreadable file look like an identical one, which is the distinction
    # worth keeping.
    rc=0
    out=$(diff <([ -f "$dst" ] && marked "$dst" || true) <(marked "$src")) || rc=$?
    [ "$rc" -le 1 ] || return 3
    printf '%s\n' "$out" |
      awk -v part="$part" '
        /^> / { print "+\t" part "\t" substr($0, 3) }
        /^< / { print "-\t" part "\t" substr($0, 3) }'
  done
}

cmd_pending() {
  local base; base=$(flake_base)
  local never=true
  [ -d "$base/nixarchy" ] && never=false

  local changes rc=0
  changes=$(pending_changes "$base") || rc=$?
  case $rc in
    0) ;;
    2) die "a selection file exists but cannot be read, so what is queued cannot be told" ;;
    *) die "the selection could not be compared with the applied copy" ;;
  esac

  jq -n \
    --arg changes "$changes" \
    --argjson never "$never" \
    --arg base "$base" \
    '
    def lines: split("\n") | map(select(length > 0));
    # A toggle reaches the diff as two lines -- the commented one leaving
    # and the live one arriving -- but it is one choice, so changes are
    # keyed on the #@ marker and a pair collapses into a single entry.
    # The surviving line decides which way it went.
    def marker: capture("#@(?<t>[a-z-]*)[ \t]+(?<n>[^ \t]+)") | (.t + ":" + .n);
    ($changes | lines | map(split("\t")) | map({
      change: .[0], file: .[1], line: (.[2] // "")
    } | . + {marker: (try (.line | marker) catch .line)})) as $c
    | ($c | group_by(.marker) | map(
        (map(select(.change == "+")) | first) as $arrived
        | (first) as $any
        | {
            marker: $any.marker,
            file:   $any.file,
            line:   (($arrived // $any).line),
            # A catalogue row (an empty marker type) goes on or off; a
            # package, option or draft line is added or removed.
            change:
              if $arrived == null then
                (if ($any.marker | startswith(":")) then "off" else "removed" end)
              else
                (if ($any.marker | startswith(":")) then "on" else "added" end)
              end
          })) as $collapsed
    | { ok: true, neverApplied: $never, base: $base,
        count: ($collapsed | length), changes: $collapsed }'
}

# Copy the selection into the flake and rebuild.
#
# This is the one command here that changes the machine, and it only ever
# runs on an explicit key.
#
# Two things make it work from a panel that has no terminal:
#
#   stdin `n\ny\n`  nixarchy-apply asks "Preview in a VM first?" and then
#                   "Build and switch now?". It reads with `|| reply=""`
#                   throughout, so a closed stdin declines the switch --
#                   the safe failure, but not the one we want here.
#
#   pkexec          nh elevates itself, and a QML Process has no tty for a
#                   password. Omarchy runs a polkit agent as an always-
#                   loaded service plugin, so pkexec puts the prompt on
#                   screen in the same shell the panel lives in.
#
# Output is streamed as plain lines -- it is a build log, and the panel
# draws it as text -- with a single JSON object on the last line, which is
# the only thing the panel parses.
cmd_apply() {
  need nixarchy-apply
  local rc=0 out

  # How many questions nixarchy-apply asks depends on the machine, and
  # answering the wrong number is silent. It asks "Preview in a VM first?"
  # only `if command -v nixarchy-preview` (nixarchy-apply:193), and always
  # asks "Build and switch now?" after it.
  #
  # A fixed `n\ny\n` was therefore right on a machine with preview installed
  # and wrong on one without: the `n` answered the SWITCH prompt, the switch
  # was declined, the `y` was never read -- and declining is not an error, so
  # this reported {"ok": true, "message": "applied"} for a rebuild that never
  # happened.
  #
  # No single script is correct both ways: `y\n` alone would answer "yes" to
  # the preview question on a machine that has it, and boot a VM nobody asked
  # for. So the condition is duplicated from nixarchy-apply:193, and THE TWO
  # MUST AGREE. Asking upstream for a non-interactive mode instead:
  # https://github.com/olafkfreund/nixarchy/issues/769
  local answers
  if command -v nixarchy-preview >/dev/null 2>&1; then
    answers=$'n\ny\n'
  else
    answers=$'y\n'
  fi

  out=$(printf '%s' "$answers" |
    NH_ELEVATION_STRATEGY="${NH_ELEVATION_STRATEGY:-pkexec}" \
    nixarchy-apply 2>&1) || rc=$?
  printf '%s\n' "$out"

  # And the belt to that brace. nixarchy-apply:225 prints "Not switching."
  # when the switch is declined and then exits 0, which is exactly why the
  # exit code has never been able to tell a switch from a decline. After the
  # fix above this should be unreachable; it is here so that if the prompts
  # change again -- they have changed once -- the panel says something true
  # rather than something reassuring.
  if printf '%s' "$out" | grep -q "Not switching\."; then
    jq -nc '{ok: false, exit: 0,
      message: "nixarchy-apply declined to switch, so nothing was applied. This means the answers it was sent did not match the questions it asked."}'
    return 0
  fi

  jq -nc --argjson rc "$rc" \
    '{ok: ($rc == 0), exit: $rc,
      message: (if $rc == 0 then "applied" else "nixarchy-apply exited " + ($rc|tostring) end)}'
}

# About a minute, and the panel says so before starting it. Worth doing:
# an index written before nixarchy #493 carries no unfree or broken flags
# at all, so every package on a stale index reads as free.
cmd_reindex() {
  need nixarchy-search
  # nixarchy-search builds the index before it opens its picker, so asking
  # it to reindex with no terminal does the work and then fails at the
  # picker. That failure is expected and not worth reporting; whether the
  # index came out fresh is, and index_stale answers it from the stamp.
  NIXARCHY_IN_PICKER=1 nixarchy-search --reindex </dev/null >/dev/null 2>&1 || true
  local stale=false
  index_stale && stale=true
  jq -nc --argjson stale "$stale" \
    '{ok: ($stale | not), indexStale: $stale,
      message: (if $stale then "the index is still stale -- run nixarchy search in a terminal to see why"
                else "index rebuilt" end)}'
}

cmd_state() {
  local stale=false
  index_stale && stale=true

  jq -n \
    --rawfile apps <(rows_tsv "$APPS" app) \
    --rawfile services <(rows_tsv "$SERVICES" service) \
    --rawfile extras <(extras_tsv) \
    --rawfile labels <(labels_tsv) \
    --argjson stale "$stale" \
    --arg appsFile "$APPS" \
    --arg servicesFile "$SERVICES" \
    --arg channel "$(machine_channel)" \
    --rawfile flakes <(cmd_flake_list) \
    '
    def lines: split("\n") | map(select(length > 0));
    def cols:  lines | map(split("\t"));

    ($labels | cols | map({key: .[0], value: .[1]}) | from_entries) as $label |

    {
      ok: true,
      indexStale: $stale,
      files: { apps: $appsFile, services: $servicesFile },
      channel: $channel,
      # What this tool declared in the system flake. Read from the same
      # command a terminal calls, so the two cannot disagree.
      flakes: (($flakes | fromjson).inputs // []),
      apps: ($apps | cols | map({
        id: .[1], category: (.[2] // ""), enabled: (.[3] == "true"),
        line: (.[4] // ""), note: (.[5] // ""),
        label: ($label[.[1]] // .[1]),
        settings: (.[1] | test("\\.settings$"))
      })),
      services: ($services | cols | map({
        id: .[1], category: (.[2] // ""), enabled: (.[3] == "true"),
        line: (.[4] // ""), note: (.[5] // ""),
        label: ($label[.[1]] // .[1]),
        settings: (.[1] | test("\\.settings$"))
      })),
      packages: ($extras | cols | map(select(.[0] == "pkg") | {
        attr: .[1], channel: (.[2] // "default")
      })),
      options: ($extras | cols | map(select(.[0] == "opt") | {
        path: .[1], set: (.[2] == "true"), line: (.[3] // "")
      })),
      drafts: ($extras | cols | map(select(.[0] == "draft") | { name: .[1] }))
    }'
}

cmd_flake() {
  local action=${1-}; shift || true
  case "$action" in
    show)   cmd_flake_show "$@" ;;
    add)    cmd_flake_add "$@" ;;
    remove) cmd_flake_remove "$@" ;;
    list)   cmd_flake_list "$@" ;;
    *) die "flake takes show, add, remove or list, not '${action:-nothing}'" ;;
  esac
}

main() {
  need jq
  local cmd=${1-}
  [ -n "$cmd" ] || die "usage: nixarchy-pkg <state|search|toggle|pkg|opt|draft|flake|pending|apply|reindex>"
  shift
  case "$cmd" in
    state) cmd_state "$@" ;;
    search) cmd_search "$@" ;;
    toggle) cmd_toggle "$@" ;;
    pkg)    cmd_pkg "$@" ;;
    draft)  cmd_draft "$@" ;;
    opt)    cmd_opt "$@" ;;
    pending) cmd_pending "$@" ;;
    apply)   cmd_apply "$@" ;;
    reindex) cmd_reindex "$@" ;;
    flake)   cmd_flake "$@" ;;
    *) die "no such command: $cmd" ;;
  esac
}

main "$@"
